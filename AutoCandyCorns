local Players = game:GetService("Players")
local plr = Players.LocalPlayer
local howLongWait = 0.5


while not plr do
    plr = Players.LocalPlayer
    task.wait()
end


local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()
local Window = Rayfield:CreateWindow({
   Name = "BLEBIK SCRIPT",
   LoadingTitle = "blebik script",
   LoadingSubtitle = "made by blebik",
   ConfigurationSaving = { Enabled = false },
})

Window:ChangeTheme("Amethyst")

local CandyTab = Window:CreateTab({ name = "Candy"})
local CandyPickUp = false


CandyTab:CreateToggle({
   Name = "Activate Candy",
   CurrentValue = CandyPickUp,
   Callback = function(v)
        CandyPickUp = v
   end,
})

CandyTab:CreateSlider({
   Name = "CD",
   Range = {0.1, 1},
   Increment = 0.1,
   CurrentValue = howLongWait,
   Callback = function(v)
      howLongWait = v
   end,
})



function pickUpCandyCorns()
    local candyCornsFolder = Workspace:FindFirstChild("CandyCorns")
    if not candyCornsFolder then print("no found folder") return end
    for i,candycorn in candyCornsFolder:GetChildren() do
        local HRP = plr.Character:FindFirstChild("HumanoidRootPart")
        if not HRP then return end
        candycorn.Position = HRP.Position
    end    
end


while true do
    task.wait(howLongWait)
    if CandyPickUp then
        pickUpCandyCorns()
    end
end




