--[[
    CelestialLib  -  ClickGui-style window library for Roblox (pure Luau)

    Usage (ModuleScript or loadstring):

        local Library = require(path.to.CelestialLib)

        local Window = Library:CreateWindow({
            Name      = "Celestial",              -- client name (top-left)
            Logo      = "rbxassetid://0",         -- optional, default logo is drawn in code
            ToggleKey = Enum.KeyCode.Insert,      -- show / hide key
            Visible   = true,                     -- open on creation (default true)
            Size      = Vector2.new(780, 480),    -- optional
            Draggable = true,                     -- main window can be dragged by its top bar
            ShowExit  = true,                     -- "Exit" button in the sidebar (destroys the GUI)
            Theme     = { Accent = Color3.fromRGB(...), Accent2 = Color3.fromRGB(...) },  -- optional
            Strings   = { Search = "...", Enabled = "...", Disabled = "..." },            -- optional texts
            Icons     = { Gear = "rbxassetid://...", Close = "...", Search = "..." },     -- optional images
            Parent    = nil,                      -- optional custom parent of the ScreenGui
        })

        local Section = Window:AddSection({ Name = "Combat", Icon = "rbxassetid://...", Category = "Main" })

        local Feature = Section:AddFunction({
            Name        = "Example",
            Description = "Short description",
            Default     = false,
            Keybind     = Enum.KeyCode.R,                 -- optional
            Callback    = function(state) end,            -- toggled (button / keybind / :Set)
            OnBind      = function(key) end,              -- keybind changed
        })

        Feature:AddToggle ({ Name = "...", Default = true, Callback = function(v) end })
        Feature:AddSlider ({ Name = "...", Min = 0, Max = 10, Default = 5, Increment = 0.5, Suffix = "", Callback = function(v) end })
        Feature:AddKeybind({ Name = "...", Default = Enum.KeyCode.X, Callback = function(key) end, Pressed = function(key) end })

    Objects:
        Window :AddSection(opts) / :Notify(title, text, duration, positive) / :Show() / :Hide() / :Toggle()
                :IsVisible() / :SetToggleKey(key) / :SelectSection(section) / :Destroy()
        Section:AddFunction(opts) (alias AddButton) / :Select()
        Feature:Set(state, silent) / :Get() / :Toggle() / :SetKeybind(key) / :GetKeybind()
                :OpenSettings() / :CloseSettings() / :ToggleSettings() / :Destroy()
                :AddToggle / :AddSlider / :AddKeybind / :AddSetting(typeName, opts)
        Setting:Set(value, silent) / :Get()

    Own setting types:
        Library.SettingTypes.MyType = {
            Init      = function(setting, opts) setting.Value = ... end,
            Normalize = function(setting, value) return value end,       -- optional
            Build     = function(setting, parent) ... setting._render = function() ... end end,
        }
        Feature:AddSetting("MyType", { Name = "...", Callback = ... })

    Keybind controls: click the key pill -> press a key. Backspace / Delete = clear, Escape = cancel.
]]

