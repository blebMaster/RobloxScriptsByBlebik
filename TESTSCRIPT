        Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 1,
    }, card)
    corner(fill, 10)
    gradient(fill, theme, 0)

    local title = newText(win, "TextLabel", card, {
        Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -112, 0, 18), Text = feature.Name,
        TextSize = 14, Weight = Enum.FontWeight.Bold, ZIndex = 2, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local desc = newText(win, "TextLabel", card, {
        Position = UDim2.fromOffset(14, 31), Size = UDim2.new(1, -28, 0, 14), Text = feature.Description,
        TextSize = 10, TextColor3 = theme.TextMuted, ZIndex = 2, TextTruncate = Enum.TextTruncate.AtEnd,
    })

    local gearBtn = create("TextButton", {
        Name = "Settings", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8),
        Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3,
    }, card)
    local gear = newIcon(win, "Gear", gearBtn, 16, theme.TextMuted)

    local bindBtn = newText(win, "TextButton", card, {
        Name = "Keybind", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -36, 0, 11),
        Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.4, TextSize = 9, Weight = Enum.FontWeight.Bold,
        TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3,
    })
    corner(bindBtn, 6)
    padding(bindBtn, 7, 7, 0, 0)

    feature._ui = {
        Card = card, Fill = fill, Desc = desc, Stroke = cardStroke, Title = title,
        Gear = gear, BindBtn = bindBtn, Hover = false,
    }

    card.MouseButton1Click:Connect(function()
        feature:Toggle()
    end)
    card.MouseButton2Click:Connect(function()
        feature:ToggleSettings()
    end)
    gearBtn.MouseButton1Click:Connect(function()
        feature:ToggleSettings()
    end)
    gearBtn.MouseEnter:Connect(function()
        gear.Tint(WHITE, true)
    end)
    gearBtn.MouseLeave:Connect(function()
        gear.Tint(feature.Enabled and WHITE or theme.TextMuted, true)
    end)
    bindBtn.MouseButton1Click:Connect(function()
        feature._capturing = true
        feature:_renderBind()
        win:_captureKey(function(key)
            feature._capturing = false
            feature:SetKeybind(key)
        end, function()
            feature._capturing = false
            feature:_renderBind()
        end)
    end)
    card.MouseEnter:Connect(function()
        feature._ui.Hover = true
        feature:_renderHover()
    end)
    card.MouseLeave:Connect(function()
        feature._ui.Hover = false
        feature:_renderHover()
    end)

    feature:_render(true)
    feature:_renderBind()
end

function Feature:_renderHover()
    local ui = self._ui
    if not ui then
        return
    end
    local theme = self.Window.Theme
    if self.Enabled then
        tween(ui.Card, TWEEN_FAST, { BackgroundColor3 = theme.Card })
        return
    end
    tween(ui.Card, TWEEN_FAST, { BackgroundColor3 = ui.Hover and theme.CardHover or theme.Card })
    tween(ui.Stroke, TWEEN_FAST, { Color = ui.Hover and theme.BorderHover or theme.Border })
end

function Feature:_render(instant)
    local ui = self._ui
    if not ui then
        return
    end
    local theme = self.Window.Theme
    local on = self.Enabled
    local info = instant and TWEEN_NOW or TWEEN_FAST
    tween(ui.Fill, info, { BackgroundTransparency = on and 0 or 1 })
    tween(ui.Desc, info, { TextColor3 = on and Color3.fromRGB(242, 232, 246) or theme.TextMuted })
    tween(ui.Stroke, info, { Color = on and theme.Accent or (ui.Hover and theme.BorderHover or theme.Border) })
    tween(ui.Card, info, { BackgroundColor3 = theme.Card })
    ui.Gear.Tint(on and WHITE or theme.TextMuted, not instant)
end

function Feature:_renderBind()
    local ui = self._ui
    if not ui then
        return
    end
    local theme = self.Window.Theme
    if self._capturing then
        ui.BindBtn.Text = self.Window.Strings.Listening
        ui.BindBtn.TextColor3 = WHITE
    else
        ui.BindBtn.Text = keyLabel(self.Keybind, self.Window.Strings.BindNone)
        ui.BindBtn.TextColor3 = self.Keybind and WHITE or theme.TextMuted
    end
end

function Feature:_setState(state, fromHotkey, silent)
    state = state and true or false
    if state == self.Enabled then
        return
    end
    self.Enabled = state
    self:_render()
    if not silent then
        fire(self.Callback, state)
    end
    if fromHotkey then
        local s = self.Window.Strings
        self.Window:Notify(self.Name, state and s.Enabled or s.Disabled, 2.2, state)
    end
end

function Feature:Set(state, silent)
    self:_setState(state, false, silent)
end

function Feature:Get()
    return self.Enabled
end

function Feature:Toggle()
    self:_setState(not self.Enabled, false, false)
end

function Feature:SetKeybind(key, silent)
    self.Keybind = normalizeKey(key)
    self:_renderBind()
    if not silent then
        fire(self.OnBind, self.Keybind)
    end
end

function Feature:GetKeybind()
    return self.Keybind
end

-- ----------------------------------------------------------------------------
-- Feature settings window
-- ----------------------------------------------------------------------------
function Feature:_buildSetting(setting)
    local def = SettingTypes[setting.Kind]
    def.Build(setting, self._list)
end

function Feature:_updateNoSettings()
    if self._noSettings then
        self._noSettings.Visible = #self.Settings == 0
    end
end

function Feature:_ensureEntry()
    if self._entry then
        return self._entry
    end
    local win = self.Window
    local theme = win.Theme
    local width = win.SettingsWidth

    -- first position: to the left of the main window (shifted down if other windows are open)
    local root = win:_rootSize()
    local mainBase = win._main.Base
    local mainX = mainBase.X.Scale * root.X + mainBase.X.Offset
    local mainY = mainBase.Y.Scale * root.Y + mainBase.Y.Offset
    local openCount = 0
    for _, f in ipairs(win._features) do
        if f._entry and f._entry.Open then
            openCount = openCount + 1
        end
    end
    local x = math.max(8, mainX - width - 14)
    local y = math.clamp(mainY + openCount * 42, 8, math.max(8, root.Y - 160))

    local entry = win:_newEntry("Settings_" .. self.Name, UDim2.fromOffset(width, HEADER_H + 60),
        UDim2.fromOffset(x, y))
    self._entry = entry

    local header = create("Frame", {
        Name = "Header", Size = UDim2.new(1, 0, 0, HEADER_H), BackgroundTransparency = 1,
    }, entry.Body)
    local gear = newIcon(win, "Gear", header, 16, theme.Text)
    gear.Frame.Position = UDim2.new(0, 22, 0.5, 0)
    newText(win, "TextLabel", header, {
        Position = UDim2.fromOffset(44, 0), Size = UDim2.new(1, -88, 1, 0), Text = self.Name, TextSize = 14,
        Weight = Enum.FontWeight.Bold, TextXAlignment = Enum.TextXAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local closeBtn = create("TextButton", {
        Name = "Close", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    }, header)
    local closeIcon = newIcon(win, "Close", closeBtn, 13, theme.TextMuted)
    closeBtn.MouseEnter:Connect(function()
        closeIcon.Tint(theme.Text, true)
    end)
    closeBtn.MouseLeave:Connect(function()
        closeIcon.Tint(theme.TextMuted, true)
    end)
    closeBtn.MouseButton1Click:Connect(function()
        self:CloseSettings()
    end)
    win:_makeDraggable(header, entry)

    local list = create("ScrollingFrame", {
        Name = "List", Position = UDim2.fromOffset(0, HEADER_H), Size = UDim2.new(1, 0, 1, -HEADER_H),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = theme.TextDim,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
    }, entry.Body)
    padding(list, 16, 16, 4, 14)
    local layout = create("UIListLayout", {
        Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
    }, list)
    self._list = list
    self._noSettings = newText(win, "TextLabel", list, {
        Name = "NoSettings", Size = UDim2.new(1, 0, 0, 28), Text = win.Strings.NoSettings, TextSize = 11,
        TextColor3 = theme.TextDim, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 0,
    })

    local function updateHeight()
        local contentH = layout.AbsoluteContentSize.Y + 4 + 14
        local h = math.clamp(HEADER_H + contentH, HEADER_H + 54, 440)
        entry.Group.Size = UDim2.fromOffset(width, h)
    end
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateHeight)
    updateHeight()

    for _, setting in ipairs(self.Settings) do
        self:_buildSetting(setting)
    end
    self:_updateNoSettings()
    return entry
end

function Feature:OpenSettings()
    local win = self.Window
    local entry = self:_ensureEntry()
    if entry.Open then
        win:_bringToFront(entry)
        return
    end
    entry.Open = true
    win:_bringToFront(entry)
    if win._visible then
        win:_setEntryVisible(entry, true)
    end
end

function Feature:CloseSettings()
    local entry = self._entry
    if not entry or not entry.Open then
        return
    end
    entry.Open = false
    if self.Window._visible then
        self.Window:_setEntryVisible(entry, false)
    else
        entry.Group.Visible = false
    end
end

function Feature:ToggleSettings()
    if self._entry and self._entry.Open then
        self:CloseSettings()
    else
        self:OpenSettings()
    end
end

function Feature:AddSetting(kind, opts)
    local def = SettingTypes[kind]
    assert(def, "[CelestialLib] unknown setting type: " .. tostring(kind))
    opts = opts or {}
    local setting = setmetatable({
        Feature = self,
        Kind = kind,
        Name = opts.Name or kind,
        Callback = opts.Callback,
        Order = #self.Settings + 1,
    }, Setting)
    def.Init(setting, opts)
    table.insert(self.Settings, setting)
    if self._list then
        self:_buildSetting(setting)
    end
    self:_updateNoSettings()
    return setting
end

function Feature:AddToggle(opts)
    return self:AddSetting("Toggle", opts)
end

function Feature:AddSlider(opts)
    return self:AddSetting("Slider", opts)
end

function Feature:AddKeybind(opts)
    return self:AddSetting("Keybind", opts)
end

function Feature:Destroy()
    local win = self.Window
    if self._entry then
        self._entry.Group:Destroy()
        self._entry = nil
    end
    if self._ui then
        self._ui.Card:Destroy()
        self._ui = nil
    end
    for i, f in ipairs(win._features) do
        if f == self then
            table.remove(win._features, i)
            break
        end
    end
    for i, f in ipairs(self.Section.Features) do
        if f == self then
            table.remove(self.Section.Features, i)
            break
        end
    end
    win:_refresh()
end

function Section:AddFunction(opts)
    if type(opts) == "string" then
        opts = { Name = opts }
    end
    opts = opts or {}
    local win = self.Window
    local feature = setmetatable({
        Window = win,
        Section = self,
        Name = opts.Name or "Function",
        Description = opts.Description or "",
        Enabled = opts.Default and true or false,
        Keybind = normalizeKey(opts.Keybind),
        Callback = opts.Callback,
        OnBind = opts.OnBind,
        Settings = {},
    }, Feature)
    feature._searchKey = utf8Lower(feature.Name .. " " .. feature.Description)

    table.insert(self.Features, feature)
    table.insert(win._features, feature)
    buildCard(feature)
    win:_refresh()

    if feature.Enabled then
        -- run the callback once the script has finished building its settings
        task.defer(function()
            fire(feature.Callback, true)
        end)
    end
    return feature
end
Section.AddButton = Section.AddFunction

-- ============================================================================
-- CreateWindow
-- ============================================================================

function Library:CreateWindow(opts)
    opts = opts or {}
    local win = setmetatable({}, Window)
    win.Name = opts.Name or "Celestial"
    win.Theme = merge(DEFAULT_THEME, opts.Theme)
    win.Strings = merge(DEFAULT_STRINGS, opts.Strings)
    win.IconAssets = opts.Icons or {}
    win.LogoImage = opts.Logo
    win.ToggleKey = normalizeKey(opts.ToggleKey) or Enum.KeyCode.Insert
    win.SettingsWidth = opts.SettingsWidth or 252
    win.Sections = {}
    win._features = {}
    win._conns = {}
    win._visible = false
    win._destroyed = false
    win._z = 10
    win._sideOrder = 0
    win._notifOrder = 0
    win._notifs = {}
    win._notifByKey = {}

    local theme = win.Theme
    local strings = win.Strings
    local size = opts.Size or Vector2.new(780, 480)
    local W, H = size.X, size.Y

    -- ScreenGui ---------------------------------------------------------------
    local guiName = opts.GuiName or "CelestialGui"
    local parent = resolveParent(opts.Parent)
    local old = parent:FindFirstChild(guiName)
    if old then
        old:Destroy()
    end
    local gui = create("ScreenGui", {
        Name = guiName, ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true, DisplayOrder = opts.DisplayOrder or 100,
    })
    win.Gui = gui
    win.Root = create("Frame", {
        Name = "Root", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
    }, gui)

    -- Notification stack (always visible, even when the GUI is hidden)
    win.NotifyList = create("Frame", {
        Name = "Notifications", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -18),
        Size = UDim2.fromOffset(NOTIF_W, 420), BackgroundTransparency = 1,
    }, gui)
    create("UIListLayout", {
        Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
    }, win.NotifyList)

    -- Main window ---------------------------------------------------------------
    local main = win:_newEntry("Main", UDim2.fromOffset(W, H), UDim2.new(0.5, -W / 2, 0.5, -H / 2))
    win._main = main
    local body = main.Body

    local topBar = create("Frame", {
        Name = "TopBar", Size = UDim2.new(1, 0, 0, TOP_H), BackgroundTransparency = 1,
    }, body)
    if opts.Draggable ~= false then
        win:_makeDraggable(topBar, main)
    end

    -- logo + name (top-left)
    local logo = newLogo(win, topBar, 38)
    logo.Position = UDim2.fromOffset(16, 13)
    newText(win, "TextLabel", topBar, {
        Name = "Title", Position = UDim2.fromOffset(62, 0), Size = UDim2.fromOffset(SIDE_W - 62, TOP_H),
        Text = win.Name, TextSize = 17, Weight = Enum.FontWeight.Bold, TextTruncate = Enum.TextTruncate.AtEnd,
    })

    -- search (top-center)
    local searchBox = create("Frame", {
        Name = "Search", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 16),
        Size = UDim2.fromOffset(300, 32), BackgroundColor3 = theme.Card, BorderSizePixel = 0,
    }, topBar)
    corner(searchBox, 10)
    local searchStroke = stroke(searchBox, theme.Border, 1)
    local searchIcon = newIcon(win, "Search", searchBox, 14, theme.TextMuted)
    searchIcon.Frame.Position = UDim2.new(0, 19, 0.5, 0)
    win.SearchInput = newText(win, "TextBox", searchBox, {
        Position = UDim2.fromOffset(36, 0), Size = UDim2.new(1, -46, 1, 0), PlaceholderText = strings.Search,
        PlaceholderColor3 = theme.TextDim, TextSize = 12, ClearTextOnFocus = false,
    })
    win.SearchInput.Focused:Connect(function()
        tween(searchStroke, TWEEN_FAST, { Color = theme.Accent })
        searchIcon.Tint(theme.Text, true)
    end)
    win.SearchInput.FocusLost:Connect(function()
        tween(searchStroke, TWEEN_FAST, { Color = theme.Border })
        searchIcon.Tint(theme.TextMuted, true)
    end)
    win.SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
        win:_refresh()
    end)

    -- divider between sidebar and content
    create("Frame", {
        Name = "Divider", Position = UDim2.fromOffset(SIDE_W, 14), Size = UDim2.new(0, 1, 1, -28),
        BackgroundColor3 = theme.Border, BorderSizePixel = 0,
    }, body)

    -- sidebar (sections)
    win.SideList = create("ScrollingFrame", {
        Name = "Sections", Position = UDim2.fromOffset(0, TOP_H), Size = UDim2.new(0, SIDE_W, 1, -(TOP_H + (opts.ShowExit == false and 12 or 60))),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
    }, body)
    padding(win.SideList, 14, 14, 0, 4)
    create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, win.SideList)

    if opts.ShowExit ~= false then
        local exitBtn = newText(win, "TextButton", body, {
            Name = "Exit", Position = UDim2.new(0, 14, 1, -48), Size = UDim2.fromOffset(SIDE_W - 28, 34),
            BackgroundColor3 = theme.Card, BackgroundTransparency = 0, Text = strings.Exit, TextSize = 12,
            Weight = Enum.FontWeight.SemiBold, TextColor3 = theme.TextMuted, TextXAlignment = Enum.TextXAlignment.Center,
        })
        corner(exitBtn, 9)
        local exitStroke = stroke(exitBtn, theme.Border, 1)
        exitBtn.MouseEnter:Connect(function()
            tween(exitBtn, TWEEN_FAST, { TextColor3 = theme.Text })
            tween(exitStroke, TWEEN_FAST, { Color = theme.Accent2 })
        end)
        exitBtn.MouseLeave:Connect(function()
            tween(exitBtn, TWEEN_FAST, { TextColor3 = theme.TextMuted })
            tween(exitStroke, TWEEN_FAST, { Color = theme.Border })
        end)
        exitBtn.MouseButton1Click:Connect(function()
            fire(opts.OnExit)
            win:Destroy()
        end)
    end

    -- content (function cards, 2 columns)
    local contentW = W - (SIDE_W + 24)
    win.Content = create("ScrollingFrame", {
        Name = "Content", Position = UDim2.fromOffset(SIDE_W + 12, TOP_H), Size = UDim2.new(1, -(SIDE_W + 24), 1, -(TOP_H + 14)),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = theme.TextDim,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
    }, body)
    padding(win.Content, 2, 8, 2, 4)
    local cell = math.floor((contentW - 2 - 8 - 10) / 2)
    create("UIGridLayout", {
        CellPadding = UDim2.fromOffset(10, 10), CellSize = UDim2.fromOffset(cell, 58),
        SortOrder = Enum.SortOrder.LayoutOrder, FillDirection = Enum.FillDirection.Horizontal,
    }, win.Content)
    win.EmptyLabel = newText(win, "TextLabel", body, {
        Name = "Empty", Position = UDim2.fromOffset(SIDE_W + 12, TOP_H + 20), Size = UDim2.new(1, -(SIDE_W + 24), 0, 24),
        Text = strings.NoResults, TextSize = 12, TextColor3 = theme.TextDim, TextXAlignment = Enum.TextXAlignment.Center,
        Visible = false,
    })

    -- Input ---------------------------------------------------------------------
    win:_track(UserInputService.InputBegan:Connect(function(input, processed)
        if win._destroyed or input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end
        -- binding mode: next key becomes the keybind
        if win._capture then
            local cap = win._capture
            win._capture = nil
            if input.KeyCode == Enum.KeyCode.Escape then
                cap.Cancel()
            elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
                cap.OnKey(nil)
            else
                cap.OnKey(input.KeyCode)
            end
            return
        end
        if input.KeyCode == win.ToggleKey then
            win:Toggle()
            return
        end
        if processed then
            return
        end
        win:_handleHotkey(input.KeyCode)
    end))

    gui.Parent = parent
    if opts.Visible ~= false then
        win:Show()
    end
    return win
end

return Library
