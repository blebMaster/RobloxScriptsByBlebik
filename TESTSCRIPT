-- ============================================================================
-- Helpers
-- ============================================================================

local function merge(base, extra)
    local out = {}
    for k, v in pairs(base) do
        out[k] = v
    end
    if extra then
        for k, v in pairs(extra) do
            out[k] = v
        end
    end
    return out
end

local function create(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

local function corner(inst, radius)
    return create("UICorner", { CornerRadius = UDim.new(0, radius) }, inst)
end

local function circle(inst)
    return create("UICorner", { CornerRadius = UDim.new(1, 0) }, inst)
end

local function stroke(inst, color, thickness)
    return create("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, inst)
end

local function padding(inst, l, r, t, b)
    return create("UIPadding", {
        PaddingLeft = UDim.new(0, l or 0),
        PaddingRight = UDim.new(0, r or 0),
        PaddingTop = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
    }, inst)
end

local function gradient(inst, theme, rotation)
    return create("UIGradient", {
        Color = ColorSequence.new(theme.Accent, theme.Accent2),
        Rotation = rotation or 0,
    }, inst)
end

local function tween(inst, info, props)
    TweenService:Create(inst, info or TWEEN_FAST, props):Play()
end

local function fire(fn, ...)
    if type(fn) ~= "function" then
        return
    end
    task.spawn(function(...)
        local ok, err = pcall(fn, ...)
        if not ok then
            warn("[CelestialLib] callback error: " .. tostring(err))
        end
    end, ...)
end

-- lowercase that also understands Cyrillic (string.lower is ASCII only)
local function utf8Lower(s)
    local ok, result = pcall(function()
        local out = {}
        for _, cp in utf8.codes(s) do
            local c = cp
            if c >= 65 and c <= 90 then
                c = c + 32
            elseif c >= 0x410 and c <= 0x42F then
                c = c + 32
            elseif c >= 0x400 and c <= 0x40F then
                c = c + 80
            end
            out[#out + 1] = utf8.char(c)
        end
        return table.concat(out)
    end)
    if ok then
        return result
    end
    return string.lower(s)
end

local function normalizeKey(value)
    if value == nil then
        return nil
    end
    if typeof(value) == "EnumItem" then
        return value
    end
    if type(value) == "string" then
        local ok, key = pcall(function()
            return Enum.KeyCode[value]
        end)
        if ok then
            return key
        end
    end
    return nil
end

local function keyLabel(key, none)
    if not key then
        return none
    end
    return KEY_NAMES[key.Name] or string.upper(key.Name)
end

local function countDecimals(n)
    local d = 0
    while d < 6 and math.abs(n * 10 ^ d - math.floor(n * 10 ^ d + 0.5)) > 1e-7 do
        d = d + 1
    end
    return d
end

local function resolveParent(custom)
    if custom then
        return custom
    end
    local env = getfenv and getfenv() or {}
    if type(env.gethui) == "function" then
        local ok, hui = pcall(env.gethui)
        if ok and hui then
            return hui
        end
    end
    local okCore, core = pcall(function()
        local c = game:GetService("CoreGui")
        local probe = Instance.new("Folder")
        probe.Parent = c
        probe:Destroy()
        return c
    end)
    if okCore and core then
        return core
    end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function newText(win, class, parent, props)
    local weight = props.Weight or Enum.FontWeight.Medium
    local base = {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        FontFace = Font.new(win.Theme.FontFamily, weight, Enum.FontStyle.Normal),
        TextSize = 12,
        TextColor3 = win.Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "",
    }
    if class == "TextButton" then
        base.AutoButtonColor = false
    elseif class == "TextBox" then
        base.ClearTextOnFocus = false
    end
    for k, v in pairs(props) do
        if k ~= "Weight" then
            base[k] = v
        end
    end
    return create(class, base, parent)
end

-- ============================================================================
-- Icons (drawn with frames, so no asset ids are required)
-- ============================================================================

local function newIcon(win, kind, parent, size, color)
    local holder = create("Frame", {
        Name = kind .. "Icon",
        Size = UDim2.fromOffset(size, size),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        BackgroundTransparency = 1,
        Active = false,
    }, parent)
    local parts = {}
    local function add(inst, prop)
        parts[#parts + 1] = { inst, prop }
    end
    local center = UDim2.fromScale(0.5, 0.5)
    local half = Vector2.new(0.5, 0.5)
    local asset = win.IconAssets[kind]

    if asset then
        local img = create("ImageLabel", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Image = asset,
            ImageColor3 = color,
        }, holder)
        add(img, "ImageColor3")
    elseif kind == "Gear" then
        local ringD = math.floor(size * 0.38 + 0.5)
        local t = math.max(1.5, size * 0.13)
        local ring = create("Frame", {
            AnchorPoint = half, Position = center, Size = UDim2.fromOffset(ringD, ringD),
            BackgroundTransparency = 1, BorderSizePixel = 0,
        }, holder)
        circle(ring)
        add(stroke(ring, color, t), "Color")
        local toothLen, toothW = size * 0.2, size * 0.2
        local r = ringD / 2 + t + toothLen / 2 - 0.5
        for i = 0, 7 do
            local a = math.rad(i * 45)
            local tooth = create("Frame", {
                AnchorPoint = half,
                Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r),
                Size = UDim2.fromOffset(toothLen, toothW),
                Rotation = i * 45,
                BackgroundColor3 = color,
                BorderSizePixel = 0,
            }, holder)
            add(tooth, "BackgroundColor3")
        end
    elseif kind == "Close" then
        for _, rot in ipairs({ 45, -45 }) do
            local bar = create("Frame", {
                AnchorPoint = half, Position = center,
                Size = UDim2.fromOffset(size * 0.8, math.max(1.5, size * 0.12)),
                Rotation = rot, BackgroundColor3 = color, BorderSizePixel = 0,
            }, holder)
            corner(bar, 1)
            add(bar, "BackgroundColor3")
        end
    elseif kind == "Search" then
        local d = size * 0.46
        local ring = create("Frame", {
            AnchorPoint = half, Position = UDim2.fromOffset(size * 0.42, size * 0.42),
            Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1, BorderSizePixel = 0,
        }, holder)
        circle(ring)
        add(stroke(ring, color, 1.6), "Color")
        local handle = create("Frame", {
            AnchorPoint = half, Position = UDim2.fromOffset(size * 0.78, size * 0.78),
            Size = UDim2.fromOffset(size * 0.34, 1.8), Rotation = 45,
            BackgroundColor3 = color, BorderSizePixel = 0,
        }, holder)
        corner(handle, 1)
        add(handle, "BackgroundColor3")
    end

    local icon = { Frame = holder }
    function icon.Tint(newColor, animate)
        for _, part in ipairs(parts) do
            if animate then
                tween(part[1], TWEEN_FAST, { [part[2]] = newColor })
            else
                part[1][part[2]] = newColor
            end
        end
    end
    return icon
end

local function newLogo(win, parent, size)
    if win.LogoImage then
        return create("ImageLabel", {
            Name = "Logo", Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
            Image = win.LogoImage, ScaleType = Enum.ScaleType.Fit,
        }, parent)
    end
    local frame = create("Frame", {
        Name = "Logo", Size = UDim2.fromOffset(size, size), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, parent)
    corner(frame, math.floor(size * 0.27))
    gradient(frame, win.Theme, 45)
    local ring = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(size * 0.46, size * 0.46), BackgroundTransparency = 1, BorderSizePixel = 0,
    }, frame)
    circle(ring)
    stroke(ring, WHITE, 2.2)
    local dot = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(size * 0.13, size * 0.13), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, frame)
    circle(dot)
    return frame
end

-- ============================================================================
-- Setting (base object)
-- ============================================================================

function Setting:Get()
    return self.Value
end

function Setting:Set(value, silent)
    local def = SettingTypes[self.Kind]
    if def and def.Normalize then
        value = def.Normalize(self, value)
    end
    if value == self.Value then
        return
    end
    self.Value = value
    if self._render then
        self._render()
    end
    if not silent then
        fire(self.Callback, value)
    end
end

-- ----------------------------------------------------------------------------
-- Toggle
-- ----------------------------------------------------------------------------
SettingTypes.Toggle = {
    Init = function(setting, opts)
        setting.Value = opts.Default and true or false
    end,
    Normalize = function(_, value)
        return value and true or false
    end,
    Build = function(setting, parent)
        local win = setting.Feature.Window
        local theme = win.Theme
        local row = newText(win, "TextButton", parent, {
            Name = setting.Name, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = setting.Order,
        })
        newText(win, "TextLabel", row, {
            Size = UDim2.new(1, -48, 1, 0), Text = setting.Name, TextSize = 12,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
        local track = create("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(36, 18), BackgroundColor3 = theme.Track, BorderSizePixel = 0,
        }, row)
        circle(track)
        local fill = create("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0,
        }, track)
        circle(fill)
        gradient(fill, theme, 0)
        local knob = create("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
            Size = UDim2.fromOffset(12, 12), BackgroundColor3 = theme.KnobOff, BorderSizePixel = 0, ZIndex = 2,
        }, track)
        circle(knob)

        local first = true
        setting._render = function()
            local on = setting.Value
            local info = first and TWEEN_NOW or TWEEN_FAST
            first = false
            tween(fill, info, { BackgroundTransparency = on and 0 or 1 })
            tween(knob, info, {
                Position = on and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                BackgroundColor3 = on and WHITE or theme.KnobOff,
            })
        end
        setting._render()
        row.MouseButton1Click:Connect(function()
            setting:Set(not setting.Value)
        end)
    end,
}

-- ----------------------------------------------------------------------------
-- Slider
-- ----------------------------------------------------------------------------
SettingTypes.Slider = {
    Init = function(setting, opts)
        setting.Min = opts.Min or 0
        setting.Max = opts.Max or 100
        if setting.Max <= setting.Min then
            setting.Max = setting.Min + 1
        end
        setting.Inc = opts.Increment or 1
        setting.Suffix = opts.Suffix or ""
        setting.Decimals = math.max(countDecimals(setting.Inc), countDecimals(setting.Min))
        setting.Value = SettingTypes.Slider.Normalize(setting, opts.Default or setting.Min)
    end,
    Normalize = function(setting, value)
        value = math.clamp(tonumber(value) or setting.Min, setting.Min, setting.Max)
        local steps = math.floor((value - setting.Min) / setting.Inc + 0.5)
        value = math.clamp(setting.Min + steps * setting.Inc, setting.Min, setting.Max)
        return tonumber(string.format("%." .. setting.Decimals .. "f", value))
    end,
    Build = function(setting, parent)
        local win = setting.Feature.Window
        local theme = win.Theme
        local function fmt(v)
            return string.format("%." .. setting.Decimals .. "f", v) .. setting.Suffix
        end

        local row = create("Frame", {
            Name = setting.Name, Size = UDim2.new(1, 0, 0, 54), BackgroundTransparency = 1, LayoutOrder = setting.Order,
        }, parent)
        newText(win, "TextLabel", row, {
            Size = UDim2.new(1, -70, 0, 16), Text = setting.Name, TextSize = 12,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
        local valueLabel = newText(win, "TextLabel", row, {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(68, 16),
            TextSize = 11, Weight = Enum.FontWeight.SemiBold, TextColor3 = theme.TextMuted,
            TextXAlignment = Enum.TextXAlignment.Right,
        })
        local hit = create("TextButton", {
            Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 18),
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        }, row)
        local track = create("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 6),
            BackgroundColor3 = theme.Track, BorderSizePixel = 0,
        }, hit)
        circle(track)
        local fill = create("Frame", {
            Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0,
        }, track)
        circle(fill)
        gradient(fill, theme, 0)
        local knob = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(12, 12),
            BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 2,
        }, track)
        circle(knob)
        newText(win, "TextLabel", row, {
            Position = UDim2.fromOffset(0, 40), Size = UDim2.new(0.5, 0, 0, 12), Text = fmt(setting.Min),
            TextSize = 9, TextColor3 = theme.TextDim,
        })
        newText(win, "TextLabel", row, {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 40), Size = UDim2.new(0.5, 0, 0, 12),
            Text = fmt(setting.Max), TextSize = 9, TextColor3 = theme.TextDim, TextXAlignment = Enum.TextXAlignment.Right,
        })

        local quick = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local first = true
        setting._render = function()
            local frac = (setting.Value - setting.Min) / (setting.Max - setting.Min)
            local info = first and TWEEN_NOW or quick
            first = false
            valueLabel.Text = fmt(setting.Value)
            tween(fill, info, { Size = UDim2.fromScale(frac, 1) })
            tween(knob, info, { Position = UDim2.new(frac, 0, 0.5, 0) })
        end
        setting._render()

        local dragging = false
        local function updateFromX(x)
            local w = math.max(track.AbsoluteSize.X, 1)
            local frac = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
            setting:Set(setting.Min + frac * (setting.Max - setting.Min))
        end
        local function isPointer(input)
            return input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch
        end
        hit.InputBegan:Connect(function(input)
            if isPointer(input) then
                dragging = true
                updateFromX(input.Position.X)
            end
        end)
        win:_track(UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromX(input.Position.X)
            end
        end))
        win:_track(UserInputService.InputEnded:Connect(function(input)
            if isPointer(input) then
                dragging = false
            end
        end))
    end,
}

-- ----------------------------------------------------------------------------
-- Keybind
-- ----------------------------------------------------------------------------
SettingTypes.Keybind = {
    Init = function(setting, opts)
        setting.Value = normalizeKey(opts.Default)
        setting.Pressed = opts.Pressed
    end,
    Normalize = function(_, value)
        return normalizeKey(value)
    end,
    Build = function(setting, parent)
        local win = setting.Feature.Window
        local theme = win.Theme
        local row = create("Frame", {
            Name = setting.Name, Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = setting.Order,
        }, parent)
        newText(win, "TextLabel", row, {
            Size = UDim2.new(1, -70, 1, 0), Text = setting.Name, TextSize = 12,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
        local btn = newText(win, "TextButton", row, {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 0, BackgroundColor3 = theme.Track,
            TextSize = 10, Weight = Enum.FontWeight.Bold, TextXAlignment = Enum.TextXAlignment.Center,
        })
        corner(btn, 6)
        padding(btn, 9, 9, 0, 0)

        local capturing = false
        setting._render = function()
            if capturing then
                btn.Text = win.Strings.Listening
                btn.TextColor3 = theme.Accent2
            else
                btn.Text = keyLabel(setting.Value, win.Strings.BindNone)
                btn.TextColor3 = setting.Value and theme.Text or theme.TextMuted
            end
        end
        setting._render()

        btn.MouseButton1Click:Connect(function()
            capturing = true
            setting._render()
            win:_captureKey(function(key)
                capturing = false
                setting:Set(key)
                setting._render()
            end, function()
                capturing = false
                setting._render()
            end)
        end)
    end,
}

-- ============================================================================
-- Window
-- ============================================================================

function Window:_track(conn)
    table.insert(self._conns, conn)
    return conn
end

function Window:_rootSize()
    local s = self.Root.AbsoluteSize
    if s.X < 10 or s.Y < 10 then
        local cam = workspace.CurrentCamera
        if cam then
            s = cam.ViewportSize
        end
    end
    return s
end

function Window:_bringToFront(entry)
    self._z = self._z + 1
    entry.Group.ZIndex = self._z
end

-- animated frame (main window / settings windows): CanvasGroup + inset body
function Window:_newEntry(name, size, position)
    local theme = self.Theme
    local group = create("CanvasGroup", {
        Name = name, Size = size, Position = position, BackgroundTransparency = 1, BorderSizePixel = 0,
        GroupTransparency = 1, Visible = false,
    }, self.Root)
    local body = create("Frame", {
        Name = "Body", Position = UDim2.fromOffset(1, 1), Size = UDim2.new(1, -2, 1, -2),
        BackgroundColor3 = theme.Background, BorderSizePixel = 0,
    }, group)
    corner(body, 12)
    stroke(body, theme.Border, 1)
    local entry = { Group = group, Body = body, Base = position, Token = 0, Open = false }
    group.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            self:_bringToFront(entry)
        end
    end)
    return entry
end

function Window:_setEntryVisible(entry, show)
    entry.Token = entry.Token + 1
    local token = entry.Token
    local group = entry.Group
    local base = entry.Base
    local lowered = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, base.Y.Offset + SLIDE)
    if show then
        if not group.Visible then
            group.GroupTransparency = 1
            group.Position = lowered
            group.Visible = true
        end
        tween(group, TWEEN_SHOW, { GroupTransparency = 0, Position = base })
    else
        tween(group, TWEEN_HIDE, { GroupTransparency = 1, Position = lowered })
        task.delay(TWEEN_HIDE.Time, function()
            if entry.Token == token and group.Parent then
                group.Visible = false
            end
        end)
    end
end

function Window:_makeDraggable(handle, entry)
    local dragging = false
    local startMouse, startBase
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startMouse = input.Position
            startBase = entry.Base
            self:_bringToFront(entry)
        end
    end)
    self:_track(UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local dx = input.Position.X - startMouse.X
        local dy = input.Position.Y - startMouse.Y
        local root = self:_rootSize()
        local gs = entry.Group.AbsoluteSize
        local ox = startBase.X.Offset + dx
        local oy = startBase.Y.Offset + dy
        local absX = startBase.X.Scale * root.X + ox
        local absY = startBase.Y.Scale * root.Y + oy
        local cx = math.clamp(absX, 80 - gs.X, root.X - 80)
        local cy = math.clamp(absY, 0, root.Y - 40)
        entry.Base = UDim2.new(startBase.X.Scale, ox + (cx - absX), startBase.Y.Scale, oy + (cy - absY))
        entry.Group.Position = entry.Base
    end))
    self:_track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

function Window:_captureKey(onKey, onCancel)
    if self._capture then
        local old = self._capture
        self._capture = nil
        old.Cancel()
    end
    self._capture = { OnKey = onKey, Cancel = onCancel }
end

function Window:_cancelCapture()
    if self._capture then
        local old = self._capture
        self._capture = nil
        old.Cancel()
    end
end

function Window:_handleHotkey(key)
    for _, feature in ipairs(self._features) do
        if feature.Keybind == key then
            feature:_setState(not feature.Enabled, true, false)
        end
        for _, setting in ipairs(feature.Settings) do
            if setting.Kind == "Keybind" and setting.Value == key then
                fire(setting.Pressed, key)
            end
        end
    end
end

-- show only the cards that belong to the active section, or those that match the search
function Window:_refresh()
    local query = utf8Lower(self.SearchInput.Text or "")
    query = string.gsub(query, "^%s+", "")
    query = string.gsub(query, "%s+$", "")
    local any = false
    for _, feature in ipairs(self._features) do
        local show
        if query == "" then
            show = feature.Section == self._active
        else
            show = string.find(feature._searchKey, query, 1, true) ~= nil
        end
        if feature._ui then
            feature._ui.Card.Visible = show
        end
        any = any or show
    end
    self.EmptyLabel.Visible = not any
end

function Window:SelectSection(section)
    if self._active and self._active ~= section then
        self._active._setActive(false)
    end
    local changed = self._active ~= section
    self._active = section
    if changed then
        section._setActive(true)
    end
    if self.SearchInput.Text ~= "" then
        self.SearchInput.Text = ""
    end
    self:_refresh()
    self.Content.CanvasPosition = Vector2.new(0, 0)
end

function Window:AddSection(opts)
    if type(opts) == "string" then
        opts = { Name = opts }
    end
    opts = opts or {}
    local theme = self.Theme
    local section = setmetatable({
        Window = self,
        Name = opts.Name or "Section",
        Icon = opts.Icon,
        Category = opts.Category,
        Features = {},
        Index = #self.Sections + 1,
    }, Section)
    table.insert(self.Sections, section)

    if section.Category ~= nil and section.Category ~= self._lastCategory then
        self._sideOrder = self._sideOrder + 1
        newText(self, "TextLabel", self.SideList, {
            Name = "Category", Size = UDim2.new(1, 0, 0, 26), Text = section.Category, TextSize = 10,
            Weight = Enum.FontWeight.SemiBold, TextColor3 = theme.TextDim, TextYAlignment = Enum.TextYAlignment.Bottom,
            LayoutOrder = self._sideOrder,
        })
    end
    self._lastCategory = section.Category

    self._sideOrder = self._sideOrder + 1
    local btn = create("TextButton", {
        Name = section.Name, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = WHITE, BackgroundTransparency = 1,
        BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = self._sideOrder,
    }, self.SideList)
    corner(btn, 9)
    local fill = create("Frame", {
        Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 1,
    }, btn)
    corner(fill, 9)
    gradient(fill, theme, 0)

    local textX = 14
    local icon
    if section.Icon then
        icon = create("ImageLabel", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(18, 18),
            BackgroundTransparency = 1, Image = section.Icon, ImageColor3 = theme.TextMuted, ZIndex = 2,
        }, btn)
        textX = 40
    end
    local label = newText(self, "TextLabel", btn, {
        Position = UDim2.fromOffset(textX, 0), Size = UDim2.new(1, -(textX + 8), 1, 0), Text = section.Name,
        TextSize = 13, Weight = Enum.FontWeight.SemiBold, TextColor3 = theme.TextMuted, ZIndex = 2,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })

    section._setActive = function(active)
        tween(fill, TWEEN_FAST, { BackgroundTransparency = active and 0 or 1 })
        tween(btn, TWEEN_FAST, { BackgroundTransparency = 1 })
        tween(label, TWEEN_FAST, { TextColor3 = active and WHITE or theme.TextMuted })
        if icon then
            tween(icon, TWEEN_FAST, { ImageColor3 = active and WHITE or theme.TextMuted })
        end
    end
    btn.MouseEnter:Connect(function()
        if self._active ~= section then
            tween(btn, TWEEN_FAST, { BackgroundTransparency = 0.93 })
            tween(label, TWEEN_FAST, { TextColor3 = theme.Text })
        end
    end)
    btn.MouseLeave:Connect(function()
        if self._active ~= section then
            tween(btn, TWEEN_FAST, { BackgroundTransparency = 1 })
            tween(label, TWEEN_FAST, { TextColor3 = theme.TextMuted })
        end
    end)
    btn.MouseButton1Click:Connect(function()
        self:SelectSection(section)
    end)

    if not self._active then
        self:SelectSection(section)
    end
    return section
end

-- ----------------------------------------------------------------------------
-- Notifications (bottom-left)
-- ----------------------------------------------------------------------------
function Window:Notify(title, message, duration, positive)
    if self._destroyed then
        return
    end
    local theme = self.Theme
    title = tostring(title or "")
    duration = duration or 2.5

    local existing = self._notifByKey[title]
    if existing then
        existing.Kill()
    end
    while #self._notifs >= 5 do
        self._notifs[1].Kill()
    end

    self._notifOrder = self._notifOrder + 1
    local holder = create("Frame", {
        Size = UDim2.fromOffset(NOTIF_W, NOTIF_H), BackgroundTransparency = 1, LayoutOrder = self._notifOrder,
    }, self.NotifyList)
    local card = create("CanvasGroup", {
        Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(-40, 0), BackgroundTransparency = 1,
        GroupTransparency = 1,
    }, holder)
    local body = create("Frame", {
        Position = UDim2.fromOffset(1, 1), Size = UDim2.new(1, -2, 1, -2), BackgroundColor3 = theme.Background,
        BorderSizePixel = 0,
    }, card)
    corner(body, 9)
    stroke(body, theme.Border, 1)
    local bar = create("Frame", {
        Position = UDim2.fromOffset(9, 11), Size = UDim2.new(0, 3, 1, -22),
        BackgroundColor3 = positive and WHITE or theme.TextDim, BorderSizePixel = 0,
    }, body)
    corner(bar, 2)
    if positive then
        gradient(bar, theme, 90)
    end
    newText(self, "TextLabel", body, {
        Position = UDim2.fromOffset(22, 8), Size = UDim2.new(1, -32, 0, 16), Text = title, TextSize = 12,
        Weight = Enum.FontWeight.Bold, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    newText(self, "TextLabel", body, {
        Position = UDim2.fromOffset(22, 26), Size = UDim2.new(1, -32, 0, 14), Text = tostring(message or ""),
        TextSize = 11, TextColor3 = positive and theme.Accent2 or theme.TextMuted,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })

    local dead = false
    local item = {}
    function item.Kill()
        if dead then
            return
        end
        dead = true
        for i, v in ipairs(self._notifs) do
            if v == item then
                table.remove(self._notifs, i)
                break
            end
        end
        if self._notifByKey[title] == item then
            self._notifByKey[title] = nil
        end
        tween(card, TWEEN_HIDE, { GroupTransparency = 1, Position = UDim2.fromOffset(-40, 0) })
        tween(holder, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.fromOffset(NOTIF_W, 0),
        })
        task.delay(0.3, function()
            holder:Destroy()
        end)
    end
    table.insert(self._notifs, item)
    self._notifByKey[title] = item

    tween(card, TWEEN_SHOW, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
    task.delay(duration, item.Kill)
end

-- ----------------------------------------------------------------------------
-- Show / hide
-- ----------------------------------------------------------------------------
function Window:Show()
    if self._destroyed or self._visible then
        return
    end
    self._visible = true
    self:_setEntryVisible(self._main, true)
    for _, feature in ipairs(self._features) do
        local entry = feature._entry
        if entry and entry.Open then
            self:_setEntryVisible(entry, true)
        end
    end
end

function Window:Hide()
    if self._destroyed or not self._visible then
        return
    end
    self._visible = false
    self:_cancelCapture()
    self.SearchInput:ReleaseFocus()
    self:_setEntryVisible(self._main, false)
    for _, feature in ipairs(self._features) do
        local entry = feature._entry
        if entry and entry.Open then
            self:_setEntryVisible(entry, false)
        end
    end
end

function Window:Toggle()
    if self._visible then
        self:Hide()
    else
        self:Show()
    end
end

function Window:SetVisible(state)
    if state then
        self:Show()
    else
        self:Hide()
    end
end

function Window:IsVisible()
    return self._visible
end

function Window:SetToggleKey(key)
    self.ToggleKey = normalizeKey(key) or self.ToggleKey
end

function Window:CloseAllSettings()
    for _, feature in ipairs(self._features) do
        feature:CloseSettings()
    end
end

function Window:Destroy()
    if self._destroyed then
        return
    end
    self._destroyed = true
    for _, conn in ipairs(self._conns) do
        conn:Disconnect()
    end
    self._conns = {}
    self.Gui:Destroy()
end

