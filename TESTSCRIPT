local PANEL_HIDDEN = UDim2.new(0, PANEL_W, 0, 0)     -- спрятано "под" главным окном
local PANEL_SHOWN  = UDim2.new(0, -PANEL_GAP, 0, 0)  -- выехало влево от главного окна

----------------------------------------------------------------------
-- Вспомогательные функции
----------------------------------------------------------------------
local function merge(base, extra)
    if extra then
        for key, value in pairs(extra) do
            base[key] = value
        end
    end
    return base
end

local function create(className, props, parent)
    local inst = Instance.new(className)
    for key, value in pairs(props) do
        inst[key] = value
    end
    inst.Parent = parent
    return inst
end

local function tween(inst, props, duration, style, direction)
    local info = TweenInfo.new(
        duration or 0.18,
        style or Enum.EasingStyle.Quad,
        direction or Enum.EasingDirection.Out
    )
    local t = TweenService:Create(inst, info, props)
    t:Play()
    return t
end

local function rounded(parent, radius)
    return create("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function circle(parent)
    return create("UICorner", { CornerRadius = UDim.new(1, 0) }, parent)
end

local function outline(parent, color, thickness, transparency)
    return create("UIStroke", {
        Color = color,
        Thickness = thickness,
        Transparency = transparency,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function pad(parent, top, right, bottom, left)
    return create("UIPadding", {
        PaddingTop = UDim.new(0, top),
        PaddingRight = UDim.new(0, right),
        PaddingBottom = UDim.new(0, bottom),
        PaddingLeft = UDim.new(0, left),
    }, parent)
end

local function newLabel(props, parent)
    return create("TextLabel", merge({
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Font = Enum.Font.Gotham,
        TextSize = 14,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Text = "",
    }, props), parent)
end

local function newButton(props, parent)
    return create("TextButton", merge({
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        Font = Enum.Font.Gotham,
        TextSize = 14,
        TextColor3 = Theme.Text,
    }, props), parent)
end

local function newScroll(props, parent)
    return create("ScrollingFrame", merge({
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        VerticalScrollBarInset = Enum.ScrollBarInset.None,
    }, props), parent)
end

-- Запускает пользовательский Callback в отдельном потоке:
-- ошибка в нём не ломает интерфейс, а ожидание (task.wait) не зависает UI.
local function fire(callback, ...)
    if type(callback) == "function" then
        task.spawn(callback, ...)
    end
end

-- Сколько знаков после запятой нужно для шага слайдера (0.1 -> 1, 0.25 -> 2, 1 -> 0)
local function decimalsOf(step)
    local text = string.format("%.8f", step)
    text = string.gsub(text, "0+$", "")
    local fraction = string.match(text, "%.(%d*)$")
    return fraction and #fraction or 0
end

local KEY_LABELS = {
    LeftShift = "LShift", RightShift = "RShift",
    LeftControl = "LCtrl", RightControl = "RCtrl",
    LeftAlt = "LAlt", RightAlt = "RAlt",
    Zero = "0", One = "1", Two = "2", Three = "3", Four = "4",
    Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9",
    Return = "Enter", Backquote = "`",
}

local function keyLabel(key)
    if not key then
        return "None"
    end
    return KEY_LABELS[key.Name] or key.Name
end

-- Куда положить ScreenGui: gethui() -> CoreGui -> PlayerGui
local function mountGui(gui)
    if typeof(gethui) == "function" then
        local ok = pcall(function()
            gui.Parent = gethui()
        end)
        if ok and gui.Parent then
            return
        end
    end

    local ok = pcall(function()
        gui.Parent = CoreGui
    end)
    if ok and gui.Parent then
        return
    end

    gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
end

-- Иконка-шестерёнка, нарисованная из Frame (без картинок и asset id):
-- кольцо + 8 зубцов. Цвет меняется через gear.SetColor(color).
local function buildGear(parent, size, color)
    local holder = create("Frame", {
        Name = "GearIcon",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, parent)

    local ringSize = size * 0.46
    local ring = create("Frame", {
        Name = "Ring",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(ringSize, ringSize),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, holder)
    circle(ring)
    local ringStroke = outline(ring, color, math.max(1.5, size * 0.12), 0)

    local teeth = {}
    for i = 0, 7 do
        -- "плечо" на весь размер иконки вращается вокруг центра, зубец сидит у его верхнего края
        local arm = create("Frame", {
            Name = "Arm",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Rotation = i * 45,
        }, holder)
        local tooth = create("Frame", {
            Name = "Tooth",
            AnchorPoint = Vector2.new(0.5, 0),
            Position = UDim2.fromScale(0.5, 0),
            Size = UDim2.fromOffset(size * 0.2, size * 0.28),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
        }, arm)
        table.insert(teeth, tooth)
    end

    local gear = { Holder = holder }

    function gear.SetColor(newColor)
        tween(ringStroke, { Color = newColor }, 0.15)
        for _, tooth in ipairs(teeth) do
            tween(tooth, { BackgroundColor3 = newColor }, 0.15)
        end
    end

    return gear
end

-- Маленькая кнопка-крестик
local function closeButton(parent, position, callback)
    local button = newButton({
        Name = "Close",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = position,
        Size = UDim2.fromOffset(28, 28),
        BackgroundTransparency = 0,
        BackgroundColor3 = Theme.Row,
        Text = "×",
        Font = Enum.Font.GothamBold,
        TextSize = 20,
        TextColor3 = Theme.SubText,
    }, parent)
    rounded(button, 8)

    button.MouseEnter:Connect(function()
        tween(button, { BackgroundColor3 = Theme.Danger, TextColor3 = Theme.Text }, 0.12)
    end)
    button.MouseLeave:Connect(function()
        tween(button, { BackgroundColor3 = Theme.Row, TextColor3 = Theme.SubText }, 0.12)
    end)
    button.MouseButton1Click:Connect(callback)

    return button
end

----------------------------------------------------------------------
-- Классы
----------------------------------------------------------------------
local Window = {}
Window.__index = Window

local Section = {}
Section.__index = Section

local Button = {}
Button.__index = Button

----------------------------------------------------------------------
-- Окно
----------------------------------------------------------------------
function Window:_Connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(self._connections, connection)
    return connection
end

function Window:SetVisible(visible)
    self.Visible = visible and true or false
    self.Root.Visible = self.Visible
    if not self.Visible then
        self:_StopListening()
    end
end

function Window:Toggle()
    self:SetVisible(not self.Visible)
end

function Window:Destroy()
    self._destroyed = true
    for _, connection in ipairs(self._connections) do
        connection:Disconnect()
    end
    self._connections = {}
    self.Gui:Destroy()
end

function Window:SelectSection(section)
    if self.ActiveSection == section then
        return
    end
    self.ActiveSection = section

    for _, other in ipairs(self.Sections) do
        local active = (other == section)
        other.Page.Visible = active
        other:_SetActive(active)
    end

    self._pageTitle.Text = section.Name
    self:CloseSettings()
    self:_StopListening()
end

-- Окно настроек: выезжает слева от главного окна
function Window:_SlidePanel(open)
    local panel = self._panel

    if open then
        self._panelOpen = true
        if not panel.Visible then
            panel.Position = PANEL_HIDDEN
            panel.Visible = true
        end
        tween(panel, { Position = PANEL_SHOWN }, 0.28, Enum.EasingStyle.Quint)
    else
        self._panelOpen = false
        local slide = tween(panel, { Position = PANEL_HIDDEN }, 0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        slide.Completed:Connect(function(state)
            if state == Enum.PlaybackState.Completed and not self._panelOpen then
                panel.Visible = false
            end
        end)
    end
end

function Window:OpenSettings(button)
    local previous = self._owner
    self._owner = button

    if self._currentBody then
        self._currentBody.Visible = false
    end
    button._body.Visible = true
    self._currentBody = button._body

    self._panelTitle.Text = button.Name
    self:_StopListening()
    self:_SlidePanel(true)

    if previous and previous ~= button then
        previous:_RefreshGear()
    end
    button:_RefreshGear()
end

function Window:CloseSettings()
    if not self._panelOpen then
        return
    end
    self:_SlidePanel(false)
    self:_StopListening()
    if self._owner then
        self._owner:_RefreshGear()
    end
end

function Window:ToggleSettings(button)
    if self._panelOpen and self._owner == button then
        self:CloseSettings()
    else
        self:OpenSettings(button)
    end
end

-- Режим "нажмите клавишу" для BindToActivate
function Window:_StartListening(bind)
    self:_StopListening()
    self._listening = bind
    bind:_Render()
end

function Window:_StopListening()
    local bind = self._listening
    self._listening = nil
    if bind then
        bind:_Render()
    end
end

function Library:CreateWindow(options)
    options = options or {}

    local width  = options.Width or 780
    local height = options.Height or 500

    local self = setmetatable({
        Title         = options.Title or "Celestial",
        Sections      = {},
        ActiveSection = nil,
        Visible       = true,
        ToggleKey     = options.ToggleKey or Enum.KeyCode.RightShift,

        _connections  = {},
        _binds        = {},
        _listening    = nil,
        _panelOpen    = false,
        _owner        = nil,
        _currentBody  = nil,
        _pageWidth    = width - SIDEBAR_W,
        _destroyed    = false,
    }, Window)

    -- ScreenGui -------------------------------------------------------
    local gui = create("ScreenGui", {
        Name = options.Name or "CelestialClickGui",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        DisplayOrder = 100,
    })
    mountGui(gui)
    self.Gui = gui

    -- Root: невидимый контейнер, который двигается мышью.
    -- Внутри него главное окно и окно настроек (оно лежит слева от главного).
    local root = create("Frame", {
        Name = "Root",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(width, height),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, gui)
    self.Root = root

    -- Главное окно ----------------------------------------------------
    local main = create("Frame", {
        Name = "Main",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Theme.Window,
        BorderSizePixel = 0,
        Active = true,
        ZIndex = 2,
    }, root)
    rounded(main, 14)
    outline(main, Theme.Line, 1, 0.92)

    -- Левая панель с разделами
    local sidebar = create("Frame", {
        Name = "Sidebar",
        Size = UDim2.new(0, SIDEBAR_W, 1, 0),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0,
    }, main)
    rounded(sidebar, 14)

    -- заплатка: делает правые углы панели прямыми
    create("Frame", {
        Name = "CornerFill",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.fromScale(1, 0),
        Size = UDim2.new(0, 14, 1, 0),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0,
    }, sidebar)

    create("Frame", {
        Name = "Divider",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.fromScale(1, 0),
        Size = UDim2.new(0, 1, 1, 0),
        BackgroundColor3 = Theme.Line,
        BackgroundTransparency = 0.94,
        BorderSizePixel = 0,
    }, sidebar)

    local header = create("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, TOP_H),
        BackgroundTransparency = 1,
    }, sidebar)

    newLabel({
        Name = "Title",
        Text = self.Title,
        Font = Enum.Font.GothamBold,
        TextSize = 22,
        Position = UDim2.fromOffset(18, 12),
        Size = UDim2.new(1, -36, 0, 26),
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, header)

    newLabel({
        Name = "Subtitle",
        Text = options.Subtitle or "ClickGui 1.16.5",
        TextSize = 12,
        TextColor3 = Theme.SubText,
        Position = UDim2.fromOffset(18, 38),
        Size = UDim2.new(1, -36, 0, 16),
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, header)

    local tabList = newScroll({
        Name = "Sections",
        Position = UDim2.fromOffset(0, TOP_H),
        Size = UDim2.new(1, 0, 1, -TOP_H),
        ScrollBarThickness = 0,
    }, sidebar)
    pad(tabList, 4, 12, 12, 12)
    create("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, tabList)
    self._tabList = tabList

    -- Правая часть: верхняя строка + страницы с кнопками
    local content = create("Frame", {
        Name = "Content",
        Position = UDim2.fromOffset(SIDEBAR_W, 0),
        Size = UDim2.new(1, -SIDEBAR_W, 1, 0),
        BackgroundTransparency = 1,
    }, main)

    local topbar = create("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, TOP_H),
        BackgroundTransparency = 1,
    }, content)

    self._pageTitle = newLabel({
        Name = "PageTitle",
        Font = Enum.Font.GothamBold,
        TextSize = 22,
        Position = UDim2.fromOffset(PAGE_PAD + 4, 0),
        Size = UDim2.new(1, -90, 1, 0),
    }, topbar)

    closeButton(topbar, UDim2.new(1, -PAGE_PAD, 0.5, 0), function()
        self:SetVisible(false)
    end)

    self._pages = create("Frame", {
        Name = "Pages",
        Position = UDim2.fromOffset(0, TOP_H),
        Size = UDim2.new(1, 0, 1, -TOP_H),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, content)

    -- Окно настроек (слева от главного) -------------------------------
    local panel = create("Frame", {
        Name = "SettingsWindow",
        AnchorPoint = Vector2.new(1, 0),
        Position = PANEL_HIDDEN,
        Size = UDim2.new(0, PANEL_W, 1, 0),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Active = true,
        Visible = false,
        ZIndex = 1,
    }, root)
    rounded(panel, 14)
    outline(panel, Theme.Line, 1, 0.92)
    self._panel = panel

    local panelHeader = create("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, TOP_H),
        BackgroundTransparency = 1,
    }, panel)

    self._panelTitle = newLabel({
        Name = "Title",
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        Position = UDim2.fromOffset(18, 12),
        Size = UDim2.new(1, -70, 0, 24),
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, panelHeader)

    newLabel({
        Name = "Subtitle",
        Text = "Настройки",
        TextSize = 12,
        TextColor3 = Theme.SubText,
        Position = UDim2.fromOffset(18, 36),
        Size = UDim2.new(1, -70, 0, 16),
    }, panelHeader)

    closeButton(panelHeader, UDim2.new(1, -14, 0.5, 0), function()
        self:CloseSettings()
    end)

    create("Frame", {
        Name = "Divider",
        Position = UDim2.fromOffset(16, TOP_H),
        Size = UDim2.new(1, -32, 0, 1),
        BackgroundColor3 = Theme.Line,
        BackgroundTransparency = 0.94,
        BorderSizePixel = 0,
    }, panel)

    self._bodies = create("Frame", {
        Name = "Bodies",
        Position = UDim2.fromOffset(0, TOP_H + 1),
        Size = UDim2.new(1, 0, 1, -(TOP_H + 1)),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, panel)

    -- Перетаскивание окна (за заголовок и верхнюю строку) ----------------
    local dragging = false
    local startX, startY, startPosition = 0, 0, root.Position

    local function makeDraggable(handle)
        handle.InputBegan:Connect(function(input)
            local kind = input.UserInputType
            if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
                dragging = true
                startX, startY = input.Position.X, input.Position.Y
                startPosition = root.Position
            end
        end)
    end
    makeDraggable(header)
    makeDraggable(topbar)

    self:_Connect(UserInputService.InputChanged, function(input)
        if not dragging then
            return
        end
        local kind = input.UserInputType
        if kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch then
            root.Position = UDim2.new(
                startPosition.X.Scale, startPosition.X.Offset + (input.Position.X - startX),
                startPosition.Y.Scale, startPosition.Y.Offset + (input.Position.Y - startY)
            )
        end
    end)

    self:_Connect(UserInputService.InputEnded, function(input)
        local kind = input.UserInputType
        if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Клавиатура: клавиша окна, назначение бинда, срабатывание биндов ----
    self:_Connect(UserInputService.InputBegan, function(input, processed)
        if self._destroyed or input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        local listening = self._listening
        if listening then
            if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                listening:SetKey(nil)
            else
                listening:SetKey(input.KeyCode)
            end
            self:_StopListening()
            return
        end

        if processed then
            return
        end

        if input.KeyCode == self.ToggleKey then
            self:Toggle()
            return
        end

        for _, bind in ipairs(self._binds) do
            if bind.Key and bind.Key == input.KeyCode then
                bind:Fire()
            end
        end
    end)

    return self
end

