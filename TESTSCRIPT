-- Разделы (слева)
----------------------------------------------------------------------
function Window:CreateSection(options)
    if type(options) == "string" then
        options = { Name = options }
    end
    options = options or {}

    local name = options.Name or ("Section " .. tostring(#self.Sections + 1))

    local section = setmetatable({
        Window  = self,
        Name    = name,
        Buttons = {},
        _count  = 0,
    }, Section)

    -- Вкладка в левой панели
    local tab = newButton({
        Name = name,
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        LayoutOrder = #self.Sections + 1,
    }, self._tabList)
    rounded(tab, 10)

    local bar = create("Frame", {
        Name = "Bar",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(3, 18),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, tab)
    rounded(bar, 2)

    local textX = 18
    local icon, iconProp
    local source = options.Icon
    if type(source) == "number" then
        source = "rbxassetid://" .. tostring(source)
    end
    if type(source) == "string" and source ~= "" then
        if string.sub(source, 1, 3) == "rbx" then
            iconProp = "ImageColor3"
            icon = create("ImageLabel", {
                Name = "Icon",
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Image = source,
                ImageColor3 = Theme.SubText,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 16, 0.5, 0),
                Size = UDim2.fromOffset(20, 20),
            }, tab)
        else
            iconProp = "TextColor3"
            icon = newLabel({
                Name = "Icon",
                Text = source,
                TextSize = 17,
                TextColor3 = Theme.SubText,
                TextXAlignment = Enum.TextXAlignment.Center,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 14, 0.5, 0),
                Size = UDim2.fromOffset(24, 24),
            }, tab)
        end
        textX = 46
    end

    local label = newLabel({
        Name = "Label",
        Text = name,
        Font = Enum.Font.GothamMedium,
        TextSize = 15,
        TextColor3 = Theme.SubText,
        Position = UDim2.fromOffset(textX, 0),
        Size = UDim2.new(1, -(textX + 8), 1, 0),
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, tab)

    section._tab = { Button = tab, Bar = bar, Label = label, Icon = icon, IconProp = iconProp }

    -- Страница с кнопками (сетка из 2 колонок)
    local page = newScroll({
        Name = name,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
    }, self._pages)
    pad(page, 4, PAGE_PAD, PAGE_PAD, PAGE_PAD)

    local cellWidth = math.floor((self._pageWidth - PAGE_PAD * 2 - GRID_GAP) / 2)
    create("UIGridLayout", {
        CellPadding = UDim2.fromOffset(GRID_GAP, GRID_GAP),
        CellSize = UDim2.fromOffset(cellWidth, CARD_H),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Top,
    }, page)
    section.Page = page

    -- Переключение между разделами
    tab.MouseEnter:Connect(function()
        if self.ActiveSection ~= section then
            tween(tab, { BackgroundTransparency = 0.93 }, 0.12)
        end
    end)
    tab.MouseLeave:Connect(function()
        if self.ActiveSection ~= section then
            tween(tab, { BackgroundTransparency = 1 }, 0.12)
        end
    end)
    tab.MouseButton1Click:Connect(function()
        self:SelectSection(section)
    end)

    table.insert(self.Sections, section)
    if not self.ActiveSection then
        self:SelectSection(section)
    end

    return section
end

function Section:_SetActive(active)
    local tab = self._tab
    tween(tab.Button, { BackgroundTransparency = active and 0.85 or 1 }, 0.16)
    tween(tab.Bar, { BackgroundTransparency = active and 0 or 1 }, 0.16)
    tween(tab.Label, { TextColor3 = active and Theme.Text or Theme.SubText }, 0.16)
    if tab.Icon then
        tween(tab.Icon, { [tab.IconProp] = active and Theme.Accent or Theme.SubText }, 0.16)
    end
end

