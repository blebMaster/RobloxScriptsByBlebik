function Button:AddToggle(options)
    options = options or {}

    local row = self:_NewRow(46)
    local toggle = {
        Name     = options.Name or "Toggle",
        Value    = options.Default == true,
        Callback = options.Callback,
    }

    newLabel({
        Name = "Label",
        Text = toggle.Name,
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, -78, 1, 0),
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    local track = create("Frame", {
        Name = "Switch",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.fromOffset(40, 22),
        BackgroundColor3 = Theme.Off,
        BorderSizePixel = 0,
    }, row)
    circle(track)

    local knob = create("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
    }, track)
    circle(knob)

    local hit = newButton({ Name = "Hit", Size = UDim2.fromScale(1, 1), ZIndex = 2 }, row)

    local function render(animate)
        local on = toggle.Value
        local position = on and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
        local color = on and Theme.Accent or Theme.Off
        if animate then
            tween(knob, { Position = position }, 0.16)
            tween(track, { BackgroundColor3 = color }, 0.16)
        else
            knob.Position = position
            track.BackgroundColor3 = color
        end
    end

    function toggle:Set(value, silent)
        value = value and true or false
        if value == self.Value then
            return
        end
        self.Value = value
        render(true)
        if not silent then
            fire(self.Callback, value)
        end
    end

    render(false)
    hit.MouseButton1Click:Connect(function()
        toggle:Set(not toggle.Value)
    end)

    table.insert(self.Settings, toggle)
    return toggle
end

