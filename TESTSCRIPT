function Button:AddSlider(options)
    options = options or {}

    local min = options.Min or 0
    local max = options.Max or 100
    if max <= min then
        max = min + 1
    end
    local step = options.Increment or 1
    if step <= 0 then
        step = 1
    end
    local suffix = options.Suffix or ""
    local numberFormat = "%." .. tostring(decimalsOf(step)) .. "f"

    local row = self:_NewRow(60)
    local slider = {
        Name     = options.Name or "Slider",
        Min      = min,
        Max      = max,
        Value    = min,
        Callback = options.Callback,
    }

    newLabel({
        Name = "Label",
        Text = slider.Name,
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
        Position = UDim2.fromOffset(14, 8),
        Size = UDim2.new(1, -100, 0, 20),
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    local valueLabel = newLabel({
        Name = "Value",
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = Theme.Accent,
        TextXAlignment = Enum.TextXAlignment.Right,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -14, 0, 8),
        Size = UDim2.fromOffset(80, 20),
    }, row)

    local track = create("Frame", {
        Name = "Track",
        Position = UDim2.new(0, 14, 0, 40),
        Size = UDim2.new(1, -28, 0, 6),
        BackgroundColor3 = Theme.Off,
        BorderSizePixel = 0,
    }, row)
    rounded(track, 3)

    local fill = create("Frame", {
        Name = "Fill",
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
    }, track)
    rounded(fill, 3)

    local knob = create("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, track)
    circle(knob)

    -- зона захвата: вся нижняя часть строки
    local hit = newButton({
        Name = "Hit",
        Position = UDim2.fromOffset(0, 28),
        Size = UDim2.new(1, 0, 1, -28),
        ZIndex = 3,
    }, row)

    -- округляем до шага и границ
    local function snap(raw)
        local value = min + math.floor((raw - min) / step + 0.5) * step
        value = math.clamp(value, min, max)
        return tonumber(string.format(numberFormat, value))
    end

    local function render()
        local alpha = (slider.Value - min) / (max - min)
        fill.Size = UDim2.fromScale(alpha, 1)
        knob.Position = UDim2.fromScale(alpha, 0.5)
        valueLabel.Text = string.format(numberFormat, slider.Value) .. suffix
    end

    function slider:Set(value, silent)
        value = snap(tonumber(value) or min)
        if value == self.Value then
            return
        end
        self.Value = value
        render()
        if not silent then
            fire(self.Callback, value)
        end
    end

    slider.Value = snap(options.Default or min)
    render()

    local function setFromX(x)
        local trackWidth = track.AbsoluteSize.X
        if trackWidth <= 0 then
            return
        end
        local alpha = math.clamp((x - track.AbsolutePosition.X) / trackWidth, 0, 1)
        slider:Set(min + (max - min) * alpha)
    end

    hit.InputBegan:Connect(function(input)
        local kind = input.UserInputType
        if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
            return
        end

        setFromX(input.Position.X)

        local moveConnection, endConnection
        moveConnection = UserInputService.InputChanged:Connect(function(changed)
            local changedKind = changed.UserInputType
            if changedKind == Enum.UserInputType.MouseMovement or changedKind == Enum.UserInputType.Touch then
                setFromX(changed.Position.X)
            end
        end)
        endConnection = UserInputService.InputEnded:Connect(function(ended)
            local endedKind = ended.UserInputType
            if endedKind == Enum.UserInputType.MouseButton1 or endedKind == Enum.UserInputType.Touch then
                moveConnection:Disconnect()
                endConnection:Disconnect()
            end
        end)
    end)

    table.insert(self.Settings, slider)
    return slider
end

