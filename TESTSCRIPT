local SIDEBAR_W = 176 -- ширина левой панели с разделами
local TOP_H     = 64  -- высота верхней строки
local PAGE_PAD  = 16  -- внутренние отступы страницы с кнопками
local GRID_GAP  = 12  -- расстояние между карточками
local CARD_H    = 88  -- высота кнопки-карточки
