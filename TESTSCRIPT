-- Настройка: BindToActivate
----------------------------------------------------------------------
function Button:AddBindToActivate(options)
    options = options or {}

    local window = self.Window
    local row = self:_NewRow(46)
    local bind = {
        Name     = options.Name or "Bind",
        Key      = options.Default,
        Callback = options.Callback,
        Changed  = options.Changed,
        Button   = self,
    }

    newLabel({
        Name = "Label",
        Text = bind.Name,
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, -120, 1, 0),
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    local keyButton = newButton({
        Name = "Key",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(92, 28),
        BackgroundTransparency = 0,
        BackgroundColor3 = Theme.Off,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
    }, row)
    rounded(keyButton, 7)

    -- "None" / название клавиши / "..." пока ждём нажатие
    function bind:_Render()
        local listening = window._listening == self
        if listening then
            keyButton.Text = "..."
            keyButton.TextColor3 = Theme.Text
            tween(keyButton, { BackgroundColor3 = Theme.Accent }, 0.12)
        else
            keyButton.Text = keyLabel(self.Key)
            keyButton.TextColor3 = self.Key and Theme.Text or Theme.SubText
            tween(keyButton, { BackgroundColor3 = Theme.Off }, 0.12)
        end
    end

    function bind:SetKey(key, silent)
        self.Key = key
        self:_Render()
        if not silent then
            fire(self.Changed, key)
        end
    end

    -- Срабатывание клавиши: свой Callback, а если его нет - активация самой кнопки
    function bind:Fire()
        if self.Callback then
            fire(self.Callback, self.Key)
        else
            self.Button:Activate()
        end
    end

    bind:_Render()

    keyButton.MouseButton1Click:Connect(function()
        if window._listening == bind then
            window:_StopListening()
        else
            window:_StartListening(bind)
        end
    end)

    table.insert(window._binds, bind)
    table.insert(self.Settings, bind)
    return bind
end

Button.AddBind = Button.AddBindToActivate

