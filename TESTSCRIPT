    end)

    button:_Refresh(true)
    return button
end

Section.AddButton = Section.CreateButton

-- Внешний вид карточки: обычная / под курсором / включена
function Button:_Refresh(instant)
    local hovered = self._hoverCard or self._hoverGear
    local active = self.Toggleable and self.Enabled

    local fill = Theme.Card
    if active then
        fill = Theme.CardActive
    elseif hovered then
        fill = Theme.CardHover
    end

    local strokeColor = active and Theme.Accent or Theme.Line
    local strokeAlpha = active and 0.35 or 0.93

    if instant then
        self._card.BackgroundColor3 = fill
        self._stroke.Color = strokeColor
        self._stroke.Transparency = strokeAlpha
    else
        tween(self._card, { BackgroundColor3 = fill }, 0.15)
        tween(self._stroke, { Color = strokeColor, Transparency = strokeAlpha }, 0.15)
    end
end

-- Шестерёнка: серая, белая под курсором, акцентная пока открыты настройки этой кнопки
function Button:_RefreshGear()
    local window = self.Window
    local open = window._panelOpen and window._owner == self

    local color = Theme.SubText
    if open then
        color = Theme.Accent
    elseif self._hoverGear then
        color = Theme.Text
    end

    self._gear.SetColor(color)
    tween(self._gear.Holder, { Rotation = (self._hoverGear or open) and 90 or 0 }, 0.3)
    tween(self._gearButton, { BackgroundTransparency = self._hoverGear and 0.9 or 1 }, 0.15)
end

function Button:SetEnabled(state, silent)
    if not self.Toggleable then
        return
    end
    state = state and true or false
    if self.Enabled == state then
        return
    end
    self.Enabled = state
    self:_Refresh()
    if not silent then
        fire(self.Callback, state)
    end
end

-- То же, что клик по карточке (его же вызывает бинд)
function Button:Activate()
    if self.Toggleable then
        self:SetEnabled(not self.Enabled)
    else
        self._card.BackgroundColor3 = Theme.CardActive -- короткая вспышка
        self:_Refresh()
        fire(self.Callback)
    end
end

function Button:OpenSettings()
    self.Window:OpenSettings(self)
end

