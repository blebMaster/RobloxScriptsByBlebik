--[[
    CelestialGui - оконное ClickGui в стиле Celestial Client (1.16.5) для Roblox / Luau.
    Это только интерфейс: никаких чит-функций, все действия задаются вашими Callback.

    ------------------------------------------------------------------
    API
    ------------------------------------------------------------------
    local Window  = Library:CreateWindow({
        Title     = "Celestial",             -- заголовок слева сверху
        Subtitle  = "ClickGui 1.16.5",       -- подпись под заголовком
        Width     = 780, Height = 500,       -- размер окна
        ToggleKey = Enum.KeyCode.RightShift, -- показать / скрыть окно
    })

    local Section = Window:CreateSection({ Name = "Основное", Icon = nil })
        -- Icon (необязательно): "rbxassetid://123", число-id или короткий текст/эмодзи

    local Button  = Section:CreateButton({
        Name        = "Название",            -- большой жирный белый текст
        Description = "Короткое описание",   -- под названием
        Toggleable  = false,                 -- true: кнопка помнит состояние вкл/выкл
        Default     = false,                 -- стартовое состояние (если Toggleable)
        Callback    = function(state) end,   -- state передаётся только при Toggleable
    })

    Шестерёнка справа сверху на кнопке открывает окно настроек слева.
    Добавляйте в него настройки (Callback на создании не вызывается):

    Button:AddToggle({ Name, Default, Callback = function(value) end })
    Button:AddSlider({ Name, Min, Max, Default, Increment, Suffix, Callback = function(value) end })
    Button:AddBindToActivate({ Name, Default = Enum.KeyCode.R,
        Callback = function(key) end,  -- если не указан, нажатие клавиши активирует саму кнопку
        Changed  = function(key) end,  -- вызывается, когда игрок выбрал другую клавишу
    })

    Каждая настройка возвращает объект: :Set(value, silent) и поле .Value (у бинда - .Key).
    Кнопка: :Activate(), :SetEnabled(state, silent), :OpenSettings().
    Окно:   :SetVisible(bool), :Toggle(), :SelectSection(section), :Destroy().

    Цвета меняются в Library.Theme (до CreateWindow).
    RUN_DEMO = false - если подключаете файл как библиотеку и демо-окно не нужно.
]]

