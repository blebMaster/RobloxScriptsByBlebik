        Size = UDim2.new(1, -62, 0, 26),
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 2,
    }, card)

    -- Короткое описание под названием
    newLabel({
        Name = "Description",
        Text = button.Description,
        TextSize = 13,
        TextColor3 = Theme.SubText,
        Position = UDim2.fromOffset(16, 44),
        Size = UDim2.new(1, -32, 0, 34),
        TextWrapped = true,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 2,
    }, card)

    -- Шестерёнка справа сверху
    local gearButton = newButton({
        Name = "Gear",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 0, 10),
        Size = UDim2.fromOffset(30, 30),
        BackgroundColor3 = Theme.Line,
        BackgroundTransparency = 1,
        ZIndex = 3,
    }, card)
    rounded(gearButton, 8)
    local gear = buildGear(gearButton, 20, Theme.SubText)

    button._card = card
    button._stroke = cardStroke
    button._gearButton = gearButton
    button._gear = gear

    -- Страница настроек этой кнопки (показывается в окне настроек) ------------
    local body = newScroll({
        Name = button.Name,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
    }, window._bodies)
    pad(body, 12, 12, 12, 12)
    create("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, body)

    button._body = body
