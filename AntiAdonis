-- ─── PHASE 5: IMPROVED METATABLE HOOK ────────────────────────────
-- CHANGED: Don't blindly block all "Detect"/"Fire" FireServer calls
-- Only block actual flagging, allow heartbeat checks through
setthreadidentity(7)
local hook
hook = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local selfName = tostring(self)
    local selfLower = selfName:lower()

    if method == "FireServer" then
        -- Block actual ban/kick/damage reports
        if selfName == "Damage" or
        selfName:find("Ban") or
        selfName:find("Kick") or
        selfName:find("FlagPlayer") or
        selfName:find("ReportPlayer") then
            return nil
        end
        
        -- CHANGED: Allow heartbeat/sync/check remotes through
        -- The original blocked everything with "Detect" which
        -- might include heartbeat response remotes
        if selfName:find("Detect") and not
        (selfLower:find("heartbeat") or selfLower:find("sync")
        or selfLower:find("keepalive") or selfLower:find("check")) then
            return nil
        end
        
        -- Track heartbeat fires for timing
        for _, hb in ipairs(HeartbeatRemotes) do
            if self == hb.remote then
                hb.lastFired = tick()
            end
        end
    end

    if method == "InvokeServer" then
        -- Same logic for RemoteFunctions
        if selfName:find("Ban") or selfName:find("Kick") or
        selfName:find("Flag") or selfName:find("Report") then
            return nil
        end
    end

    if method == "Kick" then
        if self == game:GetService("Players").LocalPlayer then
            return nil
        end
    end

    return hook(self, ...)
end)

