-- ─── PHASE 2: HEARTBEAT REMOTE DETECTION ─────────────────────────
-- Scan workspace for remotes that likely expect periodic responses
local function ScanForHeartbeatRemotes()
    local Services = {
        game:GetService("ReplicatedStorage"),
        game:GetService("ReplicatedFirst"),
        game:GetService("Workspace")
    }
    
    for _, service in ipairs(Services) do
        pcall(function()
            for _, obj in ipairs(service:GetDescendants()) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    local name = obj.Name:lower()
                    if name:find("heartbeat") or name:find("keepalive")
                    or name:find("ping") or name:find("check")
                    or name:find("verify") or name:find("sync")
                    or name:find("alive") or name:find("response")
                    or name:find("timeout") or name:find("interval") then
                        local exists = false
                        for _, existing in ipairs(HeartbeatRemotes) do
                            if existing.remote == obj then
                                exists = true
                                break
                            end
                        end
                        if not exists then
                            table.insert(HeartbeatRemotes, {
                                remote = obj,
                                type = obj.ClassName,
                                lastFired = 0
                            })
                        end
                    end
                end
            end
        end)
    end
end

ScanForHeartbeatRemotes()

