local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if checkcaller() then return oldIndex(self, key) end

    if typeof(self) == "Instance" and (key == "FireServer" or key == "InvokeServer") then
        -- Возвращаем кастомную функцию-обертку для метода
        return newcclosure(function(remote, ...)
            if checkcaller() then 
                return oldIndex(remote, key)(remote, ...) 
            end

            local path = "Unknown"
            pcall(function() path = remote:GetFullName() end)

            if string.find(path, "Remotes.Grab") then
                print(string.format("Был вызван Grab через __index (%s), подмена на safeLogTemplate", key))
                -- Получаем оригинальный метод через старый __index и вызываем его с подмененным аргументом
                local originalMethod = oldIndex(remote, key)
                return originalMethod(remote, safeLogTemplate)
            end

            logRemote(key, remote, "__index", table.pack(...))
            
            -- Вызов оригинального метода с оригинальными аргументами
            local originalMethod = oldIndex(remote, key)
            return originalMethod(remote, ...)
        end)
    end

    return oldIndex(self, key)
end))


