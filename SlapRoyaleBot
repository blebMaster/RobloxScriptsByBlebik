            local enemyRoot = char:FindFirstChild("HumanoidRootPart")
            if enemyRoot then
                local predictedPosition = enemyRoot.Position + (enemyRoot.AssemblyLinearVelocity * 0.3)
                currentAngle = currentAngle + (ORBIT_SPEED * deltaTime)
                local orbitGoal = predictedPosition + Vector3.new(math.sin(currentAngle) * ORBIT_RADIUS, 0, math.cos(currentAngle) * ORBIT_RADIUS)
                
                pathfindTo(myChar, myRoot, humanoid, orbitGoal)
            end
        end
