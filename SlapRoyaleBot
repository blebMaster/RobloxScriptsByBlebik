-- Функция поиска ближайшего врага
function getNearestHumanoidRootPart()
    local myRoot = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local nearestPlayer = nil
    local shortestDistance = math.huge 
    for _, player in ipairs(Players:GetPlayers()) do
        if player == plr then continue end 
        if player.Name == MAIN_BOT_NAME then continue end 
        if table.find(FriendList, player.Name) then continue end
        local enemyChar = player.Character 
        local enemyRoot = enemyChar and enemyChar:FindFirstChild("HumanoidRootPart")
        local enemyHumanoid = enemyChar and enemyChar:FindFirstChildOfClass("Humanoid")
        
        if enemyRoot and enemyHumanoid and enemyHumanoid.Health > 0 then
            local distance = (myRoot.Position - enemyRoot.Position).Magnitude
            if distance < shortestDistance and distance < MAX_DISTANCE then
                shortestDistance = distance
                nearestPlayer = player    
            end
        end
    end
    return nearestPlayer, nearestPlayer and nearestPlayer.Character
end
local lastPathComputation = 0
local currentWaypoints = {}
local currentWaypointIndex = 1
local isHandlingObstacle = false -- Флаг: обходим ли мы препятствие прямо сейчас

-- Функция умного следования: бег по прямой с переключением на Pathfinding при опасности
local function pathfindTo(myChar, myRoot, humanoid, targetPosition)
    local startPos = myRoot.Position
    local lookDirection = myRoot.CFrame.LookVector
    
    ---------------------------------------------------------
    -- СИСТЕМА ДАТЧИКОВ (ЛУЧЕЙ) ДЛЯ ПРОВЕРКИ СТЕН И ПРОПАСТЕЙ
    ---------------------------------------------------------
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {myChar, workspace.CurrentCamera}
    
    -- 1. Датчик Стены (смотрим на 8 студов вперед на уровне груди)
    local wallRayStart = startPos + Vector3.new(0, 2, 0)
    local wallRayResult = workspace:Raycast(wallRayStart, lookDirection * 8, raycastParams)
    local isWallAhead = wallRayResult and wallRayResult.Instance and wallRayResult.Instance.CanCollide
    
    -- 2. Датчик Пропасти (смотрим вперед на 5 студов и под наклоном вниз на 7 студов)
    local floorRayStart = startPos + (lookDirection * 5) + Vector3.new(0, -1, 0)
    local floorRayResult = workspace:Raycast(floorRayStart, Vector3.new(0, -7, 0), raycastParams)
    -- Если луч ушел в пустоту и ничего не нашел — впереди обрыв/дыра
    local isCliffAhead = not (floorRayResult and floorRayResult.Instance)

    ---------------------------------------------------------
    -- ЛОГИКА ПЕРЕКЛЮЧЕНИЯ ИНТЕЛЛЕКТА
    ---------------------------------------------------------
    
    -- Если датчики зафиксировали стену или пропасть, включаем режим "Обход"
    if isWallAhead or isCliffAhead then
        isHandlingObstacle = true
    end

    if isHandlingObstacle then
        -- Строим умный обходной путь (не чаще чем раз в 0.3 сек)
        if tick() - lastPathComputation > 0.3 then
            lastPathComputation = tick()
            local success, err = pcall(function()
                path:ComputeAsync(myRoot.Position, targetPosition)
            end)
            
            if success and path.Status == Enum.PathStatus.Success then
                currentWaypoints = path:GetWaypoints()
                currentWaypointIndex = 2
            else
                currentWaypoints = {}
                isHandlingObstacle = false -- Если путь не построился, возвращаемся к прямой
            end
        end

        -- Движение по точкам обхода
        if currentWaypoints and #currentWaypoints >= currentWaypointIndex then
            local targetWaypoint = currentWaypoints[currentWaypointIndex]
            if targetWaypoint then
                local waypointPos = targetWaypoint.Position
                local distanceToWaypoint = (myRoot.Position - waypointPos).Magnitude

                if distanceToWaypoint < 3 then
                    currentWaypointIndex = currentWaypointIndex + 1
                end

                if targetWaypoint.Action == Enum.PathWaypointAction.Jump then
                    humanoid.Jump = true
                end

                humanoid:MoveTo(waypointPos)
                return -- Выходим, пока обход не завершится
            end
        else
            -- Если все точки обхода пройдены, выключаем режим препятствия
            isHandlingObstacle = false
        end
    end

    ---------------------------------------------------------
    -- РЕЖИМ СПРИНТА (Бег по прямой по умолчанию)
    ---------------------------------------------------------
    -- Дополнительный микро-прыжок для совсем мелких кочек/ступенек
    local smallObstacleResult = workspace:Raycast(startPos - Vector3.new(0, 1, 0), lookDirection * 4, raycastParams)
    if smallObstacleResult and smallObstacleResult.Instance and smallObstacleResult.Instance.CanCollide then
        local highCheck = workspace:Raycast(startPos + Vector3.new(0, 3, 0), lookDirection * 4, raycastParams)
        if not highCheck then humanoid.Jump = true end
    end

    -- Бежим напрямую к финальной цели
    humanoid:MoveTo(targetPosition)
end


