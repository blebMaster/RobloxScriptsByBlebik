    end

    -- Логика для подчиненных ботов:
    local _, mainRoot = getMainBotCharacter()
    if not mainRoot then 
        humanoid:MoveTo(myRoot.Position)
        return 
    end

    local distToMain = (myRoot.Position - mainRoot.Position).Magnitude

    ---------------------------------------------------------
    -- СБОР И БОЙ
    ---------------------------------------------------------
    if not hasGathered then
        -- Шаг 1: Изначальный сбор БУДЕТ использовать полноценный Pathfinding
        if distToMain > START_GATHER_DIST then
            pathfindTo(myChar, myRoot, humanoid, mainRoot.Position)
        else
            hasGathered = true
            print("Бот успешно прибыл к Мейну!")
        end
    else
        -- Шаг 2: Контроль дистанции во время боя
        if distToMain > MAX_AWAY_DISTANCE then
            hasGathered = false
            print("Бот убежал далеко! Возвращение к Мейну...")
        else
            -- Шаг 3: АТАКА
            local player, char = getNearestHumanoidRootPart()
            
            if player and char and char:FindFirstChild("HumanoidRootPart") then
                local enemyRoot = char:FindFirstChild("HumanoidRootPart")
                if enemyRoot then
                    local predictedPosition = enemyRoot.Position + (enemyRoot.AssemblyLinearVelocity * 0.3)
                    currentAngle = currentAngle + (ORBIT_SPEED * deltaTime)
                    local orbitGoal = predictedPosition + Vector3.new(math.sin(currentAngle) * ORBIT_RADIUS, 0, math.cos(currentAngle) * ORBIT_RADIUS)
                    
                    pathfindTo(myChar, myRoot, humanoid, orbitGoal)
                end
            else
                -- Если врагов нет, держимся у Мейна
                if distToMain > 12 then
                    pathfindTo(myChar, myRoot, humanoid, mainRoot.Position)
                else
                    humanoid:MoveTo(myRoot.Position)
                end
            end
        end
    end
end)

