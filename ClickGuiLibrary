--// Логика перетаскивания окна (Draggable)
local function MakeDraggable(dragHandle)
local dragging = false
local dragInput, dragStart, startPos
dragHandle.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragging = true
dragStart = input.Position
startPos = MainFrame.Position
input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End then
dragging = false
end
end)
end
end)
dragHandle.InputChanged:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
dragInput = input
end
end)
UserInputService.InputChanged:Connect(function(input)
if input == dragInput and dragging then
local delta = input.Position - dragStart
MainFrame.Position = UDim2.new(
startPos.X.Scale,
startPos.X.Offset + delta.X,
startPos.Y.Scale,
startPos.Y.Offset + delta.Y
)
end
end)
end
MakeDraggable(HeaderFrame)
MakeDraggable(TopBar)
--// Сворачивание/разворачивание по RightShift
local IsOpen = true
local Toggling = false
UserInputService.InputBegan:Connect(function(input, gameProcessed)
if gameProcessed then return end
if input.KeyCode == Enum.KeyCode.RightShift and not Toggling then
Toggling = true
IsOpen = not IsOpen
if IsOpen then
MainFrame.Visible = true
UIScale.Scale = 0.92
local t = Tween(UIScale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
t.Completed:Wait()
else
local t = Tween(UIScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.92 })
t.Completed:Wait()
MainFrame.Visible = false
end
Toggling = false
end
end)
--// Управление вкладками
local Tabs = {}
local ActiveTab = nil
local function SelectTab(tabObj)
if ActiveTab == tabObj then return end
ActiveTab = tabObj
ActiveTabTitle.Text = tabObj.Name
for _, t in ipairs(Tabs) do
local isSelected = (t == tabObj)
t.Page.Visible = isSelected
if isSelected then
Tween(t.Button, TweenInfo.new(0.2), { BackgroundTransparency = 0 })
Tween(t.Indicator, TweenInfo.new(0.2), { Size = UDim2.new(0, 3, 0, 18), BackgroundTransparency = 0 })
Tween(t.Title, TweenInfo.new(0.2), { TextColor3 = CurrentTheme.TextPrimary })
if t.Icon then
Tween(t.Icon, TweenInfo.new(0.2), { ImageColor3 = CurrentTheme.Accent })
end
else
Tween(t.Button, TweenInfo.new(0.2), { BackgroundTransparency = 1 })
Tween(t.Indicator, TweenInfo.new(0.2), { Size = UDim2.new(0, 3, 0, 0), BackgroundTransparency = 1 })
Tween(t.Title, TweenInfo.new(0.2), { TextColor3 = CurrentTheme.TextSecondary })
if t.Icon then
Tween(t.Icon, TweenInfo.new(0.2), { ImageColor3 = CurrentTheme.TextSecondary })
end
end
end
end
