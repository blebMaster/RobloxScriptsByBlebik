-- 2. Slider (Ползунок)
function TabAPI.createSlider(opts)
opts = opts or {}
local text = opts.Text or "Slider"
local min = opts.Min or 0
local max = opts.Max or 100
local decimals = opts.Decimals or 0
local value = math.clamp(opts.Default or min, min, max)
local callback = opts.Callback or function() end
local Card = Create("Frame", {
Name = text .. "Slider",
Size = UDim2.new(1, 0, 0, 54),
Parent = GetNextColumn(),
}, {
Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
})
BindTheme(Card, "BackgroundColor3", "CardBg")
local CardStroke = Create("UIStroke", {
Thickness = 1,
ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
Parent = Card,
})
BindTheme(CardStroke, "Color", "Stroke")
local Label = Create("TextLabel", {
Text = text,
Size = UDim2.new(1, -68, 0, 20),
Position = UDim2.new(0, 12, 0, 7),
BackgroundTransparency = 1,
Font = Enum.Font.GothamMedium,
TextSize = 13,
TextXAlignment = Enum.TextXAlignment.Left,
TextTruncate = Enum.TextTruncate.AtEnd,
Parent = Card,
})
BindTheme(Label, "TextColor3", "TextPrimary")
local ValueLabel = Create("TextLabel", {
Text = tostring(value),
Size = UDim2.new(0, 54, 0, 20),
Position = UDim2.new(1, -66, 0, 7),
BackgroundTransparency = 1,
Font = Enum.Font.GothamBold,
TextSize = 12,
TextXAlignment = Enum.TextXAlignment.Right,
Parent = Card,
})
BindTheme(ValueLabel, "TextColor3", "Accent")
local TrackHitbox = Create("TextButton", {
Size = UDim2.new(1, -24, 0, 18),
Position = UDim2.new(0, 12, 0, 30),
BackgroundTransparency = 1,
Text = "",
AutoButtonColor = false,
Parent = Card,
})
local TrackBg = Create("Frame", {
Size = UDim2.new(1, 0, 0, 5),
Position = UDim2.new(0, 0, 0.5, -2.5),
BorderSizePixel = 0,
Parent = TrackHitbox,
}, {
Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
})
BindTheme(TrackBg, "BackgroundColor3", "ElementBg")
local initPercent = (max > min) and ((value - min) / (max - min)) or 0
local Fill = Create("Frame", {
Size = UDim2.new(initPercent, 0, 1, 0),
BorderSizePixel = 0,
Parent = TrackBg,
}, {
Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
})
BindTheme(Fill, "BackgroundColor3", "Accent")
local Thumb = Create("Frame", {
Size = UDim2.new(0, 11, 0, 11),
Position = UDim2.new(1, 0, 0.5, 0),
AnchorPoint = Vector2.new(0.5, 0.5),
BackgroundColor3 = Color3.fromRGB(245, 245, 250),
BorderSizePixel = 0,
Parent = Fill,
}, {
Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
})
local SliderObj = {}
function SliderObj:Set(newVal, silent)
value = RoundNumber(math.clamp(newVal, min, max), decimals)
local percent = (max > min) and ((value - min) / (max - min)) or 0
ValueLabel.Text = string.format("%." .. decimals .. "f", value)
Tween(Fill, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
Size = UDim2.new(percent, 0, 1, 0),
})
if not silent then
task.spawn(callback, value)
end
end
local dragging = false
local function UpdateFromInput(input)
local trackAbsPos = TrackBg.AbsolutePosition.X
local trackAbsSize = TrackBg.AbsoluteSize.X
if trackAbsSize <= 0 then return end
local relX = math.clamp((input.Position.X - trackAbsPos) / trackAbsSize, 0, 1)
local rawVal = min + (max - min) * relX
SliderObj:Set(rawVal)
end
TrackHitbox.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragging = true
UpdateFromInput(input)
end
end)
UserInputService.InputChanged:Connect(function(input)
if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
UpdateFromInput(input)
end
end)
UserInputService.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragging = false
end
end)
Card.MouseEnter:Connect(function()
Tween(CardStroke, TweenInfo.new(0.15), { Color = CurrentTheme.Accent })
end)
Card.MouseLeave:Connect(function()
Tween(CardStroke, TweenInfo.new(0.15), { Color = CurrentTheme.Stroke })
end)
SliderObj:Set(value, true)
return SliderObj
end
-- 3. Button (Кнопка)
function TabAPI.createButton(opts)
opts = opts or {}
local text = opts.Text or "Button"
local callback = opts.Callback or function() end
local Card = Create("TextButton", {
Name = text .. "Button",
Size = UDim2.new(1, 0, 0, 40),
Text = "",
AutoButtonColor = false,
Parent = GetNextColumn(),
}, {
Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
})
BindTheme(Card, "BackgroundColor3", "CardBg")
local CardStroke = Create("UIStroke", {
Thickness = 1,
ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
Parent = Card,
})
BindTheme(CardStroke, "Color", "Stroke")
local Label = Create("TextLabel", {
Text = text,
Size = UDim2.new(1, -24, 1, 0),
Position = UDim2.new(0, 12, 0, 0),
BackgroundTransparency = 1,
Font = Enum.Font.GothamSemibold,
TextSize = 13,
TextXAlignment = Enum.TextXAlignment.Center,
Parent = Card,
})
BindTheme(Label, "TextColor3", "TextPrimary")
Card.MouseEnter:Connect(function()
Tween(Card, TweenInfo.new(0.15), { BackgroundColor3 = CurrentTheme.ElementBg })
Tween(CardStroke, TweenInfo.new(0.15), { Color = CurrentTheme.Accent })
end)
Card.MouseLeave:Connect(function()
Tween(Card, TweenInfo.new(0.15), { BackgroundColor3 = CurrentTheme.CardBg })
Tween(CardStroke, TweenInfo.new(0.15), { Color = CurrentTheme.Stroke })
end)
Card.MouseButton1Click:Connect(function()
Tween(Label, TweenInfo.new(0.08), { TextColor3 = CurrentTheme.Accent })
task.delay(0.12, function()
Tween(Label, TweenInfo.new(0.15), { TextColor3 = CurrentTheme.TextPrimary })
end)
task.spawn(callback)
end)
return Card
end
return TabAPI
end
