--// Создание главного окна
function Library.CreateClickGui(config)
	config = config or {}
	local GuiName = config.Name or "Celestial"

	local CurrentTheme = {}
	for k, v in pairs(Presets[1]) do
		CurrentTheme[k] = v
	end

	-- Реестр объектов для мгновенного обновления темы
	local ThemeBindings = {}
	local CustomThemeCallbacks = {}

	local function BindTheme(instance, property, themeKey)
		instance[property] = CurrentTheme[themeKey]
		table.insert(ThemeBindings, {
			Instance = instance,
			Property = property,
			Key = themeKey,
		})
	end

	local function OnThemeUpdate(callback)
		table.insert(CustomThemeCallbacks, callback)
		callback(CurrentTheme)
	end

	local function ApplyTheme(preset)
		for k, v in pairs(preset) do
			CurrentTheme[k] = v
		end
		local info = TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		for _, bind in ipairs(ThemeBindings) do
			if bind.Instance and bind.Instance.Parent then
				Tween(bind.Instance, info, { [bind.Property] = CurrentTheme[bind.Key] })
			end
		end
		for _, cb in ipairs(CustomThemeCallbacks) do
			task.spawn(cb, CurrentTheme)
		end
	end

	-- Безопасное получение родителя для ScreenGui
	local ParentGui
	if type(gethui) == "function" then
		ParentGui = gethui()
	else
		local success, res = pcall(function()
			return CoreGui.Name
		end)
		ParentGui = success and CoreGui or LocalPlayer:WaitForChild("PlayerGui")
	end

	-- Очистка старых копий при перезапуске
